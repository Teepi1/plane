C_OK, C_WARN, C_BAD, C_ACCENT, C_DIM = 1, 2, 3, 4, 5
PASTE_START, PASTE_END = "[200~", "\x1b[201~"


class Paste(str):
    """Text that arrived as a bracketed paste, never to be read as key commands."""


def fmt_reset(reset):
    if reset is None:
        return ""
    try:
        if isinstance(reset, (int, float)):
            t = datetime.fromtimestamp(reset / 1000 if reset > 1e12 else reset, timezone.utc)
        else:
            t = datetime.fromisoformat(str(reset).replace("Z", "+00:00"))
    except ValueError:
        return ""
    secs = (t - datetime.now(timezone.utc)).total_seconds()
    if secs <= 0:
        return "now"
    if secs < 86400:
        h, m = divmod(int(secs // 60), 60)
        return f"{h}h{m:02d}m" if h else f"{m}m"
    return t.astimezone().strftime("%a %H:%M")


def ago(ts):
    secs = max(0, time.time() - ts)
    if secs < 90:
        return "just now"
    if secs < 3600:
        return f"{int(secs // 60)}m ago"
    if secs < 86400:
        return f"{int(secs // 3600)}h ago"
    return f"{int(secs // 86400)}d ago"


class Sidebar:
    def __init__(self, scr):
        self.scr = scr
        self.sel = 0
        self.items = []      # (kind, obj)
        self.rows = {}       # screen row -> item index
        self.msg, self.msg_at = "", 0
        self.last_click = (None, 0)
        self.attached = None
        self.store = Store(self.notify_ready)
        curses.curs_set(0)
        curses.use_default_colors()
        for i, c in ((C_OK, curses.COLOR_GREEN), (C_WARN, curses.COLOR_YELLOW),
                     (C_BAD, curses.COLOR_RED), (C_ACCENT, curses.COLOR_CYAN),
                     (C_DIM, curses.COLOR_WHITE)):
            curses.init_pair(i, c, -1)
        curses.mousemask(curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED
                         | curses.BUTTON3_CLICKED | curses.BUTTON3_PRESSED
                         | curses.BUTTON4_PRESSED | getattr(curses, "BUTTON5_PRESSED", 0))
        curses.mouseinterval(0)
        self.tmo = 400
        scr.timeout(self.tmo)
        scr.keypad(True)
        sys.stdout.write("\x1b[?2004h")  # bracketed paste: pastes arrive marked, not as keystrokes
        sys.stdout.flush()
        self.resized_at = 0

    def set_timeout(self, ms):
        self.tmo = ms
        self.scr.timeout(ms)

    def read(self):
        """Next key: an int (special/ord), or a Paste. Raises curses.error on timeout."""
        ch = self.scr.get_wch()
        if ch != "\x1b":
            return ord(ch) if isinstance(ch, str) else ch
        self.scr.timeout(30)
        try:
            seq = ""
            while PASTE_START.startswith(seq) and seq != PASTE_START:
                try:
                    c = self.scr.get_wch()
                except curses.error:
                    break
                seq += c if isinstance(c, str) else "?"
            if seq != PASTE_START:
                return 27  # a plain Esc (an unknown sequence after it is dropped)
            buf, deadline = "", time.time() + 3
            while not buf.endswith(PASTE_END) and time.time() < deadline:
                try:
                    c = self.scr.get_wch()
                except curses.error:
                    continue
                if isinstance(c, str):
                    buf += c
            return Paste(buf[:-len(PASTE_END)] if buf.endswith(PASTE_END) else buf)
        finally:
            self.scr.timeout(self.tmo)

    def forward_paste(self, text):
        """A paste in the sidebar was meant for the session: send it there."""
        if not attached_id():
            self.flash("open a session first; pastes go into the session")
            return
        kitty("send-text", "--match", "var:plane_role=session", "--bracketed-paste", "auto", "--", text)
        kitty("focus-window", "--match", "var:plane_role=session")

    # -- helpers
    def flash(self, text):
        self.msg, self.msg_at = text, time.time()

    def notify_ready(self, h):
        subprocess.Popen(["notify-send", "-a", "Plane", "-i", "plane", "Handoff ready", h.get("title", "")],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addnstr(y, x, text, max(0, w - x - 1), attr)
            except curses.error:
                pass

    def ask(self, question, default="", complete=None):
        """One-line input at the bottom. Returns None on Esc; Tab runs `complete`."""
        h, w = self.scr.getmaxyx()
        buf = list(default)
        curses.curs_set(1)
        self.set_timeout(-1)
        try:
            while True:
                text = "".join(buf)
                self.put(h - 3, 0, " " * w)
                self.put(h - 2, 0, " " * w)
                self.put(h - 3, 1, question, curses.color_pair(C_ACCENT) | curses.A_BOLD)
                shown = text[-(w - 4):]
                self.put(h - 2, 1, "› " + shown)
                self.scr.move(h - 2, min(w - 1, 3 + len(shown)))
                ch = self.read()
                if isinstance(ch, Paste):
                    buf.extend(c for c in " ".join(ch.split()) if c.isprintable())
                elif ch in (10, 13, curses.KEY_ENTER):
                    return text.strip()
                elif ch == 27:
                    return None
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    if buf:
                        buf.pop()
                elif ch == 21:  # ctrl+u
                    buf.clear()
                elif ch == 9 and complete:
                    buf = list(complete(text))
                elif isinstance(ch, int) and 32 <= ch < 0x110000 and chr(ch).isprintable():
                    buf.append(chr(ch))
        finally:
            curses.curs_set(0)
            self.set_timeout(400)

    def confirm(self, question):
        ans = self.ask(f"{question} (y/N)")
        return bool(ans) and ans.lower().startswith("y")

    def choose(self, title, options):
        """Pick from a short list with arrows/Enter, or type. Returns str or None."""
        idx = 0
        self.set_timeout(-1)
        try:
            while True:
                self.scr.erase()
                self.put(1, 1, title, curses.color_pair(C_ACCENT) | curses.A_BOLD)
                for i, (label, _val) in enumerate(options):
                    attr = curses.A_REVERSE if i == idx else 0
                    self.put(3 + i, 1, f" {label} ", attr)
                self.put(4 + len(options), 1, "↑↓ pick · ⏎ ok · esc cancel", curses.A_DIM)
                self.scr.refresh()
                ch = self.read()
                if isinstance(ch, Paste):
                    continue
                if ch in (curses.KEY_UP, ord("k")):
                    idx = (idx - 1) % len(options)
                elif ch in (curses.KEY_DOWN, ord("j")):
                    idx = (idx + 1) % len(options)
                elif ch in (10, 13, curses.KEY_ENTER):
                    return options[idx][1]
                elif ch == 27:
                    return None
                elif ch == curses.KEY_MOUSE:
                    try:
                        _, _, my, _, _ = curses.getmouse()
                    except curses.error:
                        continue
                    if 0 <= my - 3 < len(options):
                        return options[my - 3][1]
        finally:
            self.set_timeout(400)

    def run_claude(self, args, cwd):
        r = subprocess.run([claude_bin(), *args], cwd=cwd, capture_output=True, text=True, timeout=60)
        return r.returncode, (r.stdout + r.stderr).strip()

    # -- actions
    def attach(self, s):
        if not s["bg"]:
            pid, pids = s["pid"], {c.get("pid") for c in hypr_clients()}
            while pid > 1 and pid not in pids:
                pid = ppid_of(pid)
            if pid > 1:
                hypr_focus(f"pid:{pid}")
            elif not shutil.which("hyprctl"):
                self.flash("it's in another window (switching to it needs Hyprland)")
            else:
                self.flash("couldn't find that session's window")
            return
        if self.attached == s["id"]:
            kitty("focus-window", "--match", "var:plane_role=session")
            return
        if show_in_pane([claude_bin(), "attach", s["id"]], s.get("cwd", str(HOME)),
                        s.get("name") or s["id"], s["id"]):
            self.attached = s["id"]
        else:
            self.flash("couldn't open the session pane")

    def start_bg(self, cwd, title, extra):
        """Start in the session pane (see cmd_start), where a trust prompt can be answered."""
        if show_in_pane([SELF, "start", "--cwd", cwd, *extra], cwd, title):
            self.attached = None
            self.flash("starting… answer any prompt on the right")
        else:
            self.flash("couldn't open the session pane")
        self.store.poke()

    def new_session(self):
        opts = [(f"{Path(p).name}  ({p.replace(str(HOME), '~')})", p) for p in recent_projects()]
        opts += [("~  (home folder)", str(HOME)), ("type a path…", "")]
        cwd = self.choose("New session in which folder?", opts)
        if cwd is None:
            return
        if not cwd:
            cwd = self.ask("Folder path (tab completes):", complete=complete_dir)
            if not cwd:
                return
            cwd = os.path.abspath(os.path.expanduser(cwd))
            if not Path(cwd).is_dir():
                self.flash(f"no such folder: {cwd}")
                return
        name = self.ask("Name (optional):")
        if name is None:
            return
        prompt = self.ask("First message (optional):")
        if prompt is None:
            return
        extra = (["--name", name] if name else []) + (["--prompt", prompt] if prompt else [])
        self.start_bg(cwd, name or Path(cwd).name or "~", extra)

    def launch_handoff(self, h):
        if not h["ready"] and not self.confirm("Its session is still working on it. Start anyway?"):
            return
        src, extra = h.get("source"), []
        if src and src.get("bg") and self.confirm(f"Pause '{src.get('name')}' once this starts?"):
            extra = ["--stop-source", src["id"]]
        # Claim it first: moving the file out of the queue is atomic, so a second ⏎ or a click
        # on a row the list hasn't refreshed yet finds nothing and can't launch it again.
        done = DONE / Path(h["path"]).name
        try:
            os.replace(h["path"], done)
        except FileNotFoundError:
            self.flash("that handoff was already started")
            self.store.poke()
            return
        h2 = {k: v for k, v in h.items() if k not in ("path", "source", "ready")}
        h2["launchedAt"] = time.time()
        write_json(done, h2)
        with self.store.lock:
            self.store.handoffs = [x for x in self.store.handoffs if x["id"] != h["id"]]
        self.start_bg(h["cwd"], h.get("title") or "handoff", ["--handoff", str(done), *extra])
        if src and not src.get("bg"):
            self.flash(f"'{src.get('name')}' is in its own window: /exit there to close it")

    def resume_lost(self, r):
        """Pick up an interrupted session: reattach its background job, or resume the conversation."""
        name, cwd = r.get("name") or "", r.get("cwd") or str(HOME)
        if not Path(cwd).is_dir():
            self.flash(f"its folder is gone: {cwd}")
            return
        job = r.get("jobId")
        if r.get("kind") == "bg" and job and (CLAUDE_DIR / "jobs" / job).is_dir():
            if show_in_pane([claude_bin(), "attach", job], cwd, name or job, job):
                self.attached = job
            self.store.poke()
            return
        self.start_bg(cwd, name or lost_label(r)[:40], ["--resume", r["sessionId"]] + (["--name", name] if name else []))

    def close_lost(self, r, everything=False):
        """Done with a cut-off session: stop offering it (its conversation stays in /resume)."""
        group = self.store.lost if everything else [r]
        what = f"all {len(group)} cut-off sessions" if everything else f"'{lost_label(r)[:24]}'"
        if not self.confirm(f"Close {what}?"):
            return
        for x in group:
            job = x.get("jobId")
            if x.get("kind") == "bg" and job and (CLAUDE_DIR / "jobs" / job).is_dir():
                self.run_claude(["rm", job], HOME)  # or it would come back under PAUSED
            Path(x["path"]).unlink(missing_ok=True)
        self.flash("closed · conversation kept (claude --resume)")
        self.store.poke()

    def close(self, s):
        """Finish a session: it ends and leaves the list. Its conversation is kept, and its
        worktree is removed only when nothing in it is unpushed."""
        if not s["bg"]:
            self.flash("it's in its own window: type /exit there")
            return
        if not self.confirm(f"Close '{(s.get('name') or s['id'])[:24]}'?"):
            return
        if self.remove(s):
            self.flash("closed · conversation kept (claude --resume)")

    def remove(self, s):
        code, out = self.run_claude(["rm", s["id"]], HOME)
        if code != 0:
            self.flash(f"not closed: {out.splitlines()[0][:100] if out else 'claude rm failed'}")
        elif self.attached == s["id"]:
            self.attached = None
        self.store.poke()
        return code == 0

    def handoff_of(self, s):
        """The started handoff (in done/) that this session came from, if any."""
        for f in DONE.glob("*.json"):
            h = read_json(f)
            if h and h.get("launchedSessionId") == s["id"]:
                return f
        return None

    def requeue(self, s):
        """Undo starting a handoff: close its session and put the handoff back in the queue."""
        f = self.handoff_of(s)
        if not f:
            self.flash("no handoff to put back")
            return
        if not self.confirm(f"Close & requeue '{(s.get('name') or s['id'])[:11]}'?"):
            return
        if not self.remove(s):  # still running: requeuing now could start it twice
            return
        h = read_json(f)
        for k in ("launchedAt", "launchedSessionId"):
            h.pop(k, None)
        write_json(HANDOFFS / f.name, h)
        f.unlink(missing_ok=True)
        self.flash("closed · handoff back in the queue")
        self.store.poke()

    def pause(self, s):
        """Stop a session but keep it listed under PAUSED, to pick up again later."""
        if not s["bg"]:
            self.flash("it's in its own window: type /exit there")
            return
        if s.get("stopped"):
            self.flash("already paused · x closes it")
            return
        code, out = self.run_claude(["stop", s["id"]], HOME)
        self.flash("paused · open it to continue" if code == 0 else f"not paused: {out[:100]}")
        if self.attached == s["id"]:
            self.attached = None
        self.store.poke()

    def discard_handoff(self, h):
        if self.confirm(f"Discard handoff '{h.get('title', '')[:20]}'?"):
            Path(h["path"]).unlink(missing_ok=True)
            self.store.poke()

    def actions_for(self, kind, obj):
        """The right-click menu: (label, action) for the clicked row."""
        if kind == "session" and not obj["bg"]:
            acts = [("Go to its window", lambda: self.attach(obj))]
        elif kind == "session":
            acts = [("Continue" if obj.get("stopped") else "Open", lambda: self.attach(obj))]
            if not obj.get("stopped"):
                acts.append(("Pause", lambda: self.pause(obj)))
            acts.append(("Close", lambda: self.close(obj)))
            if self.handoff_of(obj):
                acts.append(("Put back in queue", lambda: self.requeue(obj)))
        elif kind == "lost":
            acts = [("Resume", lambda: self.resume_lost(obj)),
                    ("Close", lambda: self.close_lost(obj)),
                    ("Close all cut-off sessions", lambda: self.close_lost(obj, everything=True))]
        elif kind == "handoff":
            acts = [("Start", lambda: self.launch_handoff(obj)),
                    ("Read prompt", lambda: self.view_handoff(obj)),
                    ("Discard", lambda: self.discard_handoff(obj))]
        else:
            acts = []
        return acts + [("New session…", self.new_session)]

    def menu(self, y, options):
        """Popup under row y. Click or ⏎ picks; Esc, right-click or a click outside cancels."""
        h, w = self.scr.getmaxyx()
        width = min(w - 2, max(len(label) for label, _ in options) + 4)
        height = len(options) + 2
        top, left = max(0, min(y + 1, h - height)), 2
        win = curses.newwin(height, width, top, left)
        idx = 0
        self.set_timeout(-1)
        try:
            while True:
                win.erase()
                win.attron(curses.color_pair(C_ACCENT))
                win.box()
                win.attroff(curses.color_pair(C_ACCENT))
                for i, (label, _) in enumerate(options):
                    attr = curses.A_REVERSE if i == idx else 0
                    if label == "Discard":
                        attr |= curses.color_pair(C_BAD)
                    win.addnstr(1 + i, 2, label.ljust(width - 4), width - 4, attr)
                win.refresh()
                ch = self.read()
                if isinstance(ch, Paste):
                    continue
                if ch in (curses.KEY_UP, ord("k")):
                    idx = (idx - 1) % len(options)
                elif ch in (curses.KEY_DOWN, ord("j")):
                    idx = (idx + 1) % len(options)
                elif ch in (10, 13, curses.KEY_ENTER):
                    break
                elif ch == 27:
                    return
                elif ch == curses.KEY_MOUSE:
                    try:
                        _, mx, my, _, bstate = curses.getmouse()
                    except curses.error:
                        continue
                    if not bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                        if bstate & (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED):
                            return
                        continue
                    if top < my < top + height - 1 and left <= mx < left + width:
                        idx = my - top - 1
                        break
                    return
        finally:
            del win
            self.set_timeout(400)
            self.scr.touchwin()
        options[idx][1]()

    def view_handoff(self, h):
        view = CACHE / "handoff-view.txt"
        view.write_text(f"{h.get('title')}\nfrom {h.get('sourceName') or '?'} · {h['cwd']}\n\n{h['prompt']}\n")
        show_in_pane(["less", str(view)], h["cwd"], f"handoff: {h.get('title')}")
        self.attached = None

    # -- drawing
    def bar(self, y, label, win):
        w = self.scr.getmaxyx()[1]
        if not win:
            self.put(y, 1, f"{label}  --", curses.A_DIM)
            return
        pct = win["pct"]
        color = C_OK if pct < 50 else C_WARN if pct < 80 else C_BAD
        width = max(6, min(14, w - 24))
        fill = round(width * min(pct, 100) / 100)
        self.put(y, 1, f"{label} ", curses.A_BOLD)
        self.put(y, 4, "█" * fill, curses.color_pair(color))
        self.put(y, 4 + fill, "░" * (width - fill), curses.A_DIM)
        self.put(y, 5 + width, f"{pct:>3.0f}%", curses.color_pair(color) | curses.A_BOLD)
        reset = fmt_reset(win.get("resetsAt"))
        if reset:
            self.put(y, 11 + width, f"↻ {reset}", curses.A_DIM)

    def session_line(self, s):
        if s.get("stopped"):
            return "○", C_DIM, "failed" if s.get("state") == "failed" else "paused"
        if s.get("status") == "busy":
            return "●", C_OK, "working"
        if s["bg"] and s.get("state") == "blocked":
            return "!", C_WARN, "needs you"
        return "○", C_ACCENT, "your turn"

    def draw_item(self, y, w, idx):
        kind, obj = self.items[idx]
        attr = curses.A_REVERSE if idx == self.sel else 0
        self.put(y, 0, " " * (w - 1), attr)
        if kind == "session":
            icon, color, state = self.session_line(obj)
            dim = curses.A_DIM if obj.get("stopped") else 0
            if obj.get("id") and obj.get("id") == self.attached:
                self.put(y, 1, "▶", curses.color_pair(C_ACCENT) | attr)
            self.put(y, 2, icon, curses.color_pair(color) | attr | curses.A_BOLD)
            name = obj.get("name") or obj.get("id") or "?"
        elif kind == "lost":
            color, state, dim = C_WARN, {"crashed": "crash"}.get(obj["cause"], obj["cause"]), 0
            self.put(y, 2, "↯", curses.color_pair(C_WARN) | attr | curses.A_BOLD)
            name = lost_label(obj)
        else:
            ok = obj["ready"]
            color, state, dim = (C_OK if ok else C_WARN), ("ready" if ok else "pending"), 0
            self.put(y, 2, "✓" if ok else "…", curses.color_pair(color) | attr | curses.A_BOLD)
            name = obj.get("title", "?")
        room = w - 4 - len(state) - 3
        self.put(y, 4, name if len(name) <= room else name[:max(3, room - 1)] + "…", attr | dim)
        self.put(y, w - len(state) - 2, state, curses.color_pair(color) | attr | dim)

    def detail_lines(self, w):
        if not self.items:
            return []
        kind, obj = self.items[self.sel]
        lines = []
        if kind == "session":
            lines.append(obj.get("cwd", "").replace(str(HOME), "~"))
            if obj.get("branch"):
                lines.append(f"branch {obj['branch']}")
            if obj.get("startedAt"):
                lines.append(f"started {ago(obj['startedAt'] / 1000)}")
            if obj.get("needs") and obj.get("state") == "blocked":
                lines.append(f"needs: {obj['needs']}")
            if not obj["bg"]:
                lines.append("in its own window · /exit there to close")
        elif kind == "lost":
            where = obj.get("lastCwd") or obj.get("cwd", "")
            lines.append(where.replace(str(HOME), "~"))
            if git_branch(where):
                lines.append(f"branch {git_branch(where)}")
            when = obj.get("lastActive") or obj.get("seenAt")
            if when:
                lines.append(f"last active {ago(when)} · cut off by a {'reboot' if obj['cause'] == 'reboot' else 'crash'}")
            if obj.get("lastPrompt"):
                lines.append(f"last ask: {obj['lastPrompt']}")
        else:
            src = obj.get("source")
            where = "ended" if not src else ("still working" if src.get("status") == "busy" else "done")
            lines.append(f"from {obj.get('sourceName') or '?'} ({where})")
            lines.append(obj.get("cwd", "").replace(str(HOME), "~"))
            lines.append(f"queued {ago(obj.get('createdAt', time.time()))}")
            lines += [ln.strip() for ln in obj.get("prompt", "").splitlines() if ln.strip()][:5]
        return lines

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        with self.store.lock:
            sessions = list(self.store.sessions)
            handoffs = list(self.store.handoffs)
            lost = list(self.store.lost)
            usage = dict(self.store.usage)
            err = self.store.error
        mine = [s for s in sessions if s["bg"] and not s.get("stopped")]
        paused = [s for s in sessions if s["bg"] and s.get("stopped")]
        windows = [s for s in sessions if not s["bg"]]
        self.items = ([("lost", r) for r in lost] + [("session", s) for s in mine + paused + windows]
                      + [("handoff", x) for x in handoffs])
        self.sel = max(0, min(self.sel, len(self.items) - 1))
        self.rows = {}

        self.put(0, 1, "PLANE", curses.color_pair(C_ACCENT) | curses.A_BOLD)
        if usage.get("updatedAt"):
            self.put(0, 8, f"usage {ago(usage['updatedAt'])}", curses.A_DIM)
        self.bar(1, "5h", usage.get("five_hour"))
        self.bar(2, "wk", usage.get("seven_day"))

        # body: section headings and item rows, scrolled to keep the selection visible
        body, idx = [], 0
        for title, group, empty in (("CUT OFF BY CRASH/REBOOT", lost, None),
                                    ("SESSIONS", mine, "none running · n starts one"),
                                    ("PAUSED", paused, None),
                                    ("IN OTHER WINDOWS", windows, None),
                                    ("HANDOFFS", handoffs, "none queued")):
            if not group and empty is None:
                continue
            if body:
                body.append(("gap", None))
            body.append(("head", title))
            if not group:
                body.append(("note", empty))
            for _ in group:
                body.append(("item", idx))
                idx += 1

        details = self.detail_lines(w)
        top, bottom = 4, h - 3
        avail = bottom - top
        if len(body) + len(details) + 2 <= avail:
            offset, show_details = 0, True
        else:
            sel_row = next((i for i, (k, v) in enumerate(body) if k == "item" and v == self.sel), 0)
            off = min(max(getattr(self, "offset", 0), sel_row - avail + 1), sel_row)
            if off == sel_row and off > 0 and body[off - 1][0] == "head":
                off -= 1  # keep the section heading in view
            self.offset = offset = off
            show_details = False
        y = top
        for kind, val in body[offset:offset + avail]:
            if kind == "head":
                self.put(y, 1, val, curses.A_BOLD | (curses.color_pair(C_WARN) if val.startswith("CUT OFF") else 0))
            elif kind == "note":
                self.put(y, 3, val, curses.A_DIM)
            elif kind == "item":
                self.draw_item(y, w, val)
                self.rows[y] = val
            y += 1
        if offset > 0:
            self.put(top - 1, w - 7, "▲ more", curses.A_DIM)
        if offset + avail < len(body):
            self.put(bottom, w - 7, "▼ more", curses.A_DIM)

        if show_details and details:
            y += 1
            self.put(y, 0, "─" * (w - 1), curses.A_DIM)
            for ln in details:
                y += 1
                if y >= bottom:
                    break
                self.put(y, 1, ln[:w - 2], curses.A_DIM)

        if self.msg and time.time() - self.msg_at < 6:
            self.put(h - 2, 1, self.msg[:w - 2], curses.color_pair(C_WARN))
        elif err:
            self.put(h - 2, 1, err[:w - 2], curses.color_pair(C_BAD))
        kind, obj = self.items[self.sel] if self.items else (None, None)
        if kind == "handoff":
            hint = "v read  x discard  n new  ? keys"
        elif kind == "lost" or (kind == "session" and obj["bg"] and obj.get("stopped")):
            hint = "x close  n new  ? keys"
        elif kind == "session" and obj["bg"]:
            hint = "x close  p pause  n new  ? keys"
        else:
            hint = "n new session  ? keys"
        self.put(h - 1, 1, hint, curses.A_DIM)
        scr.refresh()

    def help(self):
        self.scr.erase()
        rows = [  # the sidebar is ~38 columns: keys in 9, words in 26
            ("x", "close: done, off the list"),
            ("", "conversation is kept"),
            ("p", "pause: stays listed"),
            ("n", "new session"),
            ("v", "read a handoff"),
            ("x", "on a handoff: discard it"),
            ("⏎ click", "open the selected row"),
            ("", "handoff: ⏎ or double-click"),
            ("r-click", "all actions for a row"),
            ("↑↓ jk", "move the selection"),
            ("super ←→", "sidebar ⇄ session"),
            ("r / R", "refresh / reload code"),
            ("q", "quit (sessions go on)"),
            ("", ""),
            (None, "In a session, ← on an empty"),
            (None, "prompt opens Claude's own"),
            (None, "list; ⏎ there comes back."),
        ]
        self.put(1, 1, "KEYS", curses.color_pair(C_ACCENT) | curses.A_BOLD)
        for i, (k, d) in enumerate(rows):
            self.put(3 + i, 1, k or "", curses.A_BOLD)
            self.put(3 + i, 1 if k is None else 11, d, curses.A_DIM)
        self.put(4 + len(rows), 1, "any key to go back", curses.A_DIM)
        self.set_timeout(-1)
        self.read()
        self.set_timeout(400)

    def current(self):
        return self.items[self.sel] if self.items else (None, None)

    def activate(self):
        kind, obj = self.current()
        if kind == "session":
            self.attach(obj)
        elif kind == "handoff":
            self.launch_handoff(obj)
        elif kind == "lost":
            self.resume_lost(obj)

    def click(self, row):
        # A handoff starts a whole session, so it needs a double-click (or ⏎) to start.
        # Both clicks must land on the same handoff entry: keyed by its id, not the row,
        # because the list can refresh and shift between the two clicks.
        now = time.time()
        kind, obj = self.items[row]
        key = (kind, obj.get("id") if isinstance(obj, dict) else row)
        prev_key, prev_at = self.last_click
        if key == prev_key and now - prev_at < 0.08:
            return  # the same physical click reported twice (pressed + clicked)
        self.last_click = (key, now)
        self.sel = row
        if kind != "handoff":
            self.activate()
        elif key == prev_key and now - prev_at < 0.5:
            self.last_click = (None, 0)
            self.activate()
        else:
            self.flash("double-click or press Enter to start")

    def loop(self):
        last_sync = 0
        while True:
            if time.time() - last_sync > 3:
                self.attached = attached_id()
                last_sync = time.time()
            self.draw()
            if self.resized_at and time.time() - self.resized_at > 0.3:
                self.resized_at = 0
                fit_sidebar()
            try:
                ch = self.read()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return
            if isinstance(ch, Paste):
                dbg(f"paste {ch[:40]!r}")
                self.forward_paste(ch)
                continue
            mev = None
            if ch == curses.KEY_MOUSE:
                try:
                    mev = curses.getmouse()
                except curses.error:
                    pass
                dbg(f"mouse {mev} rows={sorted(self.rows)}")
            else:
                dbg(f"key {curses.keyname(ch) if isinstance(ch, int) and 0 <= ch < 512 else ch!r}")
            if ch == curses.KEY_RESIZE:
                self.resized_at = time.time()
                continue
            kind, obj = self.current()
            if ch in (curses.KEY_UP, ord("k")):
                self.sel = max(0, self.sel - 1)
            elif ch in (curses.KEY_DOWN, ord("j")):
                self.sel = min(len(self.items) - 1, self.sel + 1)
            elif ch in (curses.KEY_HOME, ord("g")):
                self.sel = 0
            elif ch in (curses.KEY_END, ord("G")):
                self.sel = len(self.items) - 1
            elif ch in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT, ord("l")):
                self.activate()
            elif ch == ord("n"):
                self.new_session()
            elif ch in (ord("x"), ord("X"), ord("d")):
                if kind == "session":
                    self.close(obj)
                elif kind == "lost":
                    self.close_lost(obj)
                elif kind == "handoff":
                    self.discard_handoff(obj)
            elif ch == ord("p") and kind == "session":
                self.pause(obj)
            elif ch == ord("v") and kind == "handoff":
                self.view_handoff(obj)
            elif ch == ord("r"):
                self.store.poke()
            elif ch == ord("R"):  # reload the sidebar's code in place; the session pane stays
                curses.endwin()
                os.execv(sys.executable, [sys.executable, SELF, "sidebar"])
            elif ch == ord("?"):
                self.help()
            elif ch == ord("q"):
                kitty("close-window", "--match", "var:plane_role=session")
                return
            elif ch == curses.KEY_MOUSE:
                if mev is None:
                    continue
                _, _, my, _, bstate = mev
                if bstate & curses.BUTTON4_PRESSED:
                    self.sel = max(0, self.sel - 1)
                elif bstate & getattr(curses, "BUTTON5_PRESSED", 0):
                    self.sel = min(len(self.items) - 1, self.sel + 1)
                elif bstate & (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED):
                    if my in self.rows:
                        self.sel = self.rows[my]
                        self.draw()
                        self.menu(my, self.actions_for(*self.items[self.sel]))
                    else:
                        self.menu(my, self.actions_for(None, None))
                elif my in self.rows and bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                    self.click(self.rows[my])


def cmd_sidebar(_args):
    os.environ.setdefault("ESCDELAY", "25")
    for d in (HANDOFFS, DONE, CACHE, LIVE):
        d.mkdir(parents=True, exist_ok=True)
    try:
        curses.wrapper(lambda scr: Sidebar(scr).loop())
    finally:
        sys.stdout.write("\x1b[?2004l")
        sys.stdout.flush()


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="plane", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("open").set_defaults(fn=cmd_open)
    sub.add_parser("sidebar").set_defaults(fn=cmd_sidebar)
    sub.add_parser("statusline").set_defaults(fn=cmd_statusline)
    st = sub.add_parser("start", help="start a background session (runs in the session pane)")
    st.add_argument("--cwd")
    st.add_argument("--name")
    st.add_argument("--prompt")
    st.add_argument("--handoff", help="a claimed handoff file in done/")
    st.add_argument("--stop-source", help="session id to stop once the new one is running")
    st.add_argument("--resume", help="conversation id to continue as a background session")
    st.set_defaults(fn=cmd_start)
    fo = sub.add_parser("focus", help="move focus between Plane's panes")
    fo.add_argument("dir", choices=["left", "right", "up", "down"])
    fo.set_defaults(fn=cmd_focus)
    tr = sub.add_parser("track", help="Claude Code hook: record running sessions")
    tr.add_argument("event", choices=["start", "prompt", "end"])
    tr.set_defaults(fn=cmd_track)
    rc = sub.add_parser("recover", help="notify about interrupted sessions and waiting handoffs")
    rc.add_argument("--delay", type=float, default=8)
    rc.set_defaults(fn=cmd_recover)
    ho = sub.add_parser("handoff").add_subparsers(dest="hcmd", required=True)
    add = ho.add_parser("add", help="queue a handoff prompt read from stdin")
    add.add_argument("--title", required=True)
    add.add_argument("--cwd")
    add.set_defaults(fn=cmd_handoff_add)
    args = ap.parse_args()
    (getattr(args, "fn", None) or cmd_open)(args)


if __name__ == "__main__":
    main()
