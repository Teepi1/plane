def claude_bin():
    return shutil.which("claude") or str(HOME / ".local/bin/claude")


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)


def ppid_of(pid):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def in_phone_terminal(pid):
    """Started from the phone app's Terminal tab (an ancestor is `plane web`): no desktop window."""
    while pid > 1:
        try:
            args = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except OSError:
            return False
        if b"web" in args and any(a.endswith(b"plane") for a in args):
            return True
        pid = ppid_of(pid)
    return False


def hypr(*args):
    """Hyprland is optional: without it, window focusing outside Plane is skipped."""
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5)
    except OSError:
        return subprocess.CompletedProcess(args, 127, "", "hyprctl not found")


def hypr_clients():
    try:
        return json.loads(hypr("clients", "-j").stdout)
    except (ValueError, OSError, subprocess.SubprocessError):
        return []


def hypr_dispatch(lua, *classic):
    """Hyprland 0.56+ takes Lua dispatches; older versions take the classic form."""
    r = hypr("dispatch", lua)
    out = (r.stdout + r.stderr).lower()
    if r.returncode != 0 or "invalid" in out or "error" in out:
        hypr("dispatch", *classic)


def hypr_focus(selector):
    hypr_dispatch(f'hl.dsp.focus({{ window = "{selector}" }})', "focuswindow", selector)


def hypr_move_focus(direction):
    hypr_dispatch(f'hl.dsp.focus({{ direction = "{direction}" }})', "movefocus", direction[0])


# ---------------------------------------------------------------- open

def cmd_open(_args):
    if any(c.get("class") == CLASS for c in hypr_clients()):
        hypr_focus(f"class:^({CLASS})$")
        return
    if SOCK.exists() and kitty("focus-window", "--match", "cmdline:sidebar").returncode == 0:
        return  # already open (no Hyprland to ask): kitty raises it
    SOCK.unlink(missing_ok=True)
    subprocess.Popen(
        ["kitty", "--class", CLASS, "--title", "Plane",
         "-o", "allow_remote_control=socket-only",
         "--listen-on", f"unix:{SOCK}",
         "-o", "enabled_layouts=splits",
         "--directory", str(HOME),
         SELF, "sidebar"],
        start_new_session=True, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------- focus

def cmd_focus(args):
    """Super+arrows: inside Plane, move between its panes; past its edge or in any other
    window, plain Hyprland focus. Safe to bind globally."""
    if shutil.which("hyprctl"):
        try:
            active = json.loads(hypr("activewindow", "-j").stdout or "{}").get("class")
        except ValueError:
            active = None
        if active != CLASS:
            hypr_move_focus(args.dir)
            return
    side = {"up": "top", "down": "bottom"}.get(args.dir, args.dir)
    r = kitty("focus-window", "--match", f"neighbor:{side}")
    dbg(f"focus {args.dir} rc={r.returncode} {r.stderr.strip()[:120]}")
    if r.returncode != 0:
        hypr_move_focus(args.dir)


# ---------------------------------------------------------------- statusline

def _window(rl, *names):
    """Pull (percent, resets_at) for one window out of whatever shape rate_limits has."""
    if isinstance(rl, dict):
        for n in names:
            w = rl.get(n)
            if isinstance(w, dict):
                pct = next((w[k] for k in ("used_percentage", "percentUsed", "percent_used",
                                           "utilization", "used") if k in w), None)
                reset = next((w[k] for k in ("resets_at", "resetsAt") if k in w), None)
                if pct is not None:
                    return {"pct": float(pct), "resetsAt": reset}
    if isinstance(rl, list):
        for w in rl:
            if isinstance(w, dict) and w.get("kind") in names:
                return {"pct": float(w.get("percentUsed", 0)), "resetsAt": w.get("resetsAt")}
    return None


def cmd_statusline(_args):
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    rl = payload.get("rate_limits") or payload.get("rateLimits")
    five = _window(rl, "five_hour", "fiveHour", "5h")
    week = _window(rl, "seven_day", "sevenDay", "weekly", "7d")
    if five or week:
        write_json(USAGE, {"five_hour": five, "seven_day": week, "updatedAt": time.time()})
    parts = []
    if five:
        parts.append(f"5h {five['pct']:.0f}%")
    if week:
        parts.append(f"wk {week['pct']:.0f}%")
    print(" · ".join(parts))


# ---------------------------------------------------------------- handoff add

def find_source_session():
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            break
        info = read_json(CLAUDE_DIR / "sessions" / f"{pid}.json")
        if info:
            return info
        pid = ppid_of(pid)
    return None


def repo_root(cwd):
    # A handoff starts at the main checkout; the prompt itself moves into the worktree.
    return cwd.split("/.worktrees/")[0].split("/.claude/worktrees/")[0]


def all_folders():
    """Every project's handoff folders, in the order they're listed: {project path: [names]}."""
    data = read_json(FOLDERS, {}) or {}
    return {p: [n for n in names if isinstance(n, str) and n.strip()]
            for p, names in data.items() if isinstance(names, list)}


def project_folders(cwd):
    return all_folders().get(cwd, [])


def folder_name(cwd, name):
    """A typed folder name, spelled the way the project already spells it (Orders, not orders)."""
    name = " ".join(str(name or "").split())
    return next((n for n in project_folders(cwd) if n.lower() == name.lower()), name)


def add_project_folder(cwd, name):
    data = read_json(FOLDERS, {}) or {}
    names = data.setdefault(cwd, [])
    if name and name not in names:
        names.append(name)
        write_json(FOLDERS, data)


def rename_project_folder(cwd, old, new):
    """Rename a folder in a project's list and in every queued handoff filed under it."""
    data = read_json(FOLDERS, {}) or {}
    names = data.setdefault(cwd, [])
    if old in names:
        names[names.index(old)] = new
    elif new not in names:
        names.append(new)
    data[cwd] = list(dict.fromkeys(names))  # renaming onto an existing folder merges the two
    write_json(FOLDERS, data)
    for f in HANDOFFS.glob("*.json"):
        h = read_json(f)
        if h and h.get("cwd") == cwd and old in handoff_folders(h):
            set_handoff_folders(h, [new if n == old else n for n in handoff_folders(h)])
            write_json(f, h)


def handoff_folders(h):
    """The folders a handoff is filed in. A handoff can be in several (Launch and Printers,
    say); it's still one handoff, so starting or discarding it takes it out of all of them.
    Files from before several folders were possible have a single "folder"."""
    names = h.get("folders")
    if not isinstance(names, list):
        names = [h.get("folder")]
    return list(dict.fromkeys(n for n in names if isinstance(n, str) and n))


def set_handoff_folders(h, names):
    h.pop("folder", None)
    names = list(dict.fromkeys(n for n in names if n))
    if names:
        h["folders"] = names
    else:
        h.pop("folders", None)


def handoff_tree(handoffs, folders, is_open, rank=None):
    """The HANDOFFS section as rows of (kind, obj, depth): a project, then its folders (each
    listed only while it holds a handoff), then its handoffs that aren't in a folder, the way
    a file tree lists folders before files. A handoff in several folders is listed in each;
    its row is a copy with "_place" saying where (the folder's id, or the project's path).
    `handoffs` come in display order; projects are ordered by `rank` (default: newest
    handoff first); folders keep the project's own order."""
    by_proj = {}
    for h in handoffs:
        by_proj.setdefault(h.get("cwd") or "", []).append(h)
    rank = rank or (lambda p, hs: -max((h.get("createdAt") or 0) for h in hs))
    rows = []
    for p in sorted(by_proj, key=lambda p: rank(p, by_proj[p])):
        hs, order = by_proj[p], folders.get(p, [])
        groups = {}
        for h in hs:
            for n in handoff_folders(h) or [""]:
                groups.setdefault(n, []).append(h)
        names = [n for n in order if n in groups] + sorted((n for n in groups if n and n not in order), key=str.lower)
        node = {"id": p, "cwd": p, "name": Path(p).name or p, "count": len(hs), "folders": len(names),
                "waiting": sum(1 for h in hs if not h.get("ready", True))}
        rows.append(("project", node, 0))
        if not is_open(("project", p)):
            continue
        for n in names:
            fid = f"{p}\n{n}"
            fhs = groups[n]
            rows.append(("folder", {"id": fid, "cwd": p, "name": n, "count": len(fhs),
                                    "waiting": sum(1 for h in fhs if not h.get("ready", True))}, 1))
            if is_open(("folder", fid)):
                rows += [("handoff", dict(h, _place=fid), 2) for h in fhs]
        rows += [("handoff", dict(h, _place=p), 1) for h in groups.get("", [])]
    return rows


def cmd_handoff_add(args):
    prompt = sys.stdin.read().strip()
    fence = re.match(r"^```[\w-]*\n(.*)\n```$", prompt, re.S)
    if fence:
        prompt = fence.group(1).strip()
    if not prompt:
        sys.exit("plane: empty handoff prompt (pass it on stdin)")
    src = find_source_session() or {}
    cwd = repo_root(os.path.abspath(args.cwd or src.get("cwd") or os.getcwd()))
    now = time.time()
    slug = re.sub(r"[^a-z0-9]+", "-", args.title.lower()).strip("-")[:40] or "handoff"
    hid = f"{datetime.now():%Y%m%d-%H%M%S}-{slug}"
    folders = list(dict.fromkeys(folder_name(cwd, f) for f in args.folder or [] if f.strip()))
    for f in folders:
        add_project_folder(cwd, f)
    write_json(HANDOFFS / f"{hid}.json", {
        "id": hid, "title": args.title, "cwd": cwd, "prompt": prompt, "createdAt": now,
        "sourceSessionId": src.get("sessionId"), "sourceName": src.get("name"),
        "sourcePid": src.get("pid"), "sourceProcStart": src.get("procStart"),
        **({"folders": folders} if folders else {}),
    })
    origin = f" (from session '{src['name']}')" if src.get("name") else ""
    where = f" under {Path(cwd).name} › {', '.join(folders)}" if folders else ""
    print(f"Queued handoff '{args.title}' in Plane{where}{origin}.")


def cmd_handoff_folders(args):
    """List a project's handoff folders, one per line (for the /handoff skill to pick from)."""
    cwd = repo_root(os.path.abspath(args.cwd or os.getcwd()))
    for name in project_folders(cwd):
        print(name)


# ---------------------------------------------------------------- session ledger
# Every session writes LIVE/<sessionId>.json from its hooks and marks it ended when it
# exits. A crash, power loss or reboot never gets that far, so a record whose process is
# gone and that isn't marked ended is a session that was cut off mid-work.

def boot_id():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return ""


def proc_start(pid):
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def proc_alive(pid, start=None):
    return bool(pid) and proc_start(pid) is not None and (not start or proc_start(pid) == str(start))


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0")
    except OSError:
        return []


def is_headless(pid):
    return any(a in ("-p", "--print") for a in cmdline(pid))


def hook_claude_pid():
    """The Claude process that ran this hook: the nearest ancestor that is `claude`."""
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            return 0
        argv = cmdline(pid)
        if (CLAUDE_DIR / "sessions" / f"{pid}.json").exists() or (argv and Path(argv[0]).name == "claude"):
            return pid
        pid = ppid_of(pid)
    return 0


def shutting_down():
    """True while the machine or the desktop session is going down (exits then aren't choices)."""
    checks = (["systemctl", "is-system-running"],
              ["systemctl", "--user", "is-active", "wayland-session-shutdown.target"],
              ["systemctl", "--user", "is-active", "graphical-session.target"])
    for cmd, bad in zip(checks, ({"stopping"}, {"active", "activating"}, {"deactivating", "inactive"})):
        try:
            if subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout.strip() in bad:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    return False


def ledger_update(sid, pid, **fields):
    f = LIVE / f"{sid}.json"
    rec = read_json(f, {}) or {}
    info = read_json(CLAUDE_DIR / "sessions" / f"{pid}.json", {}) or {}
    switched = rec.get("pid") != pid
    if switched:  # a new process for this conversation (resumed): it's live again
        rec.pop("ended", None)
    rec.update({k: v for k, v in fields.items() if v})
    rec.update(sessionId=sid, pid=pid, procStart=proc_start(pid), bootId=boot_id(), seenAt=time.time())
    for key in ("kind", "jobId", "name"):
        if info.get(key):
            rec[key] = info[key]
    rec.setdefault("cwd", info.get("cwd") or fields.get("lastCwd") or str(HOME))  # launch dir: where --resume finds it
    rec.setdefault("startedAt", time.time())
    write_json(f, rec)
    if switched:
        retire_replaced(rec)


def retire_replaced(rec):
    """A process runs one conversation at a time. A `--resume` start first reports a throwaway
    session id, then the resumed one, and the throwaway never gets SessionEnd: end it here,
    or it would come back as a second, cut-off copy of the session after a reboot."""
    for f in LIVE.glob("*.json"):
        old = read_json(f, {}) or {}
        if (old.get("sessionId") != rec["sessionId"] and not old.get("ended") and old.get("pid") == rec["pid"]
                and old.get("procStart") == rec["procStart"] and old.get("bootId") == rec["bootId"]):
            old.update(ended=time.time(), endReason="replaced")
            write_json(f, old)


def ledger_end(job_id, reason):
    """`claude rm` ends a background session without SessionEnd reaching our hook: mark its
    records ended here, or a session you closed would come back as cut off by a crash."""
    for f in LIVE.glob("*.json"):
        rec = read_json(f, {}) or {}
        if not rec.get("ended") and job_id in (rec.get("jobId"), rec.get("sessionId")):
            rec.update(ended=time.time(), endReason=reason)
            write_json(f, rec)


def cmd_track(args):
    """Hook entry point. Prints nothing (hook stdout lands in the conversation) and never fails."""
    try:
        payload = json.load(sys.stdin)
        sid = payload.get("session_id")
        pid = hook_claude_pid()
        if not sid or not pid or is_headless(pid):
            return
        f = LIVE / f"{sid}.json"
        if args.event == "end":
            rec = read_json(f)
            if rec and not shutting_down():
                rec.update(ended=time.time(), endReason=payload.get("reason"))
                write_json(f, rec)
            return
        fields = {"lastCwd": payload.get("cwd"), "transcript": payload.get("transcript_path")}
        if args.event == "prompt":
            prompt = " ".join(str(payload.get("prompt", "")).split())[:300]
            fields.update(lastPrompt=prompt, lastActive=time.time())
            if not (read_json(f, {}) or {}).get("firstPrompt"):
                fields["firstPrompt"] = prompt
        ledger_update(sid, pid, **fields)
    except Exception:
        pass


def ledger_sync():
    """Record sessions that started before the hooks existed; drop old ended records."""
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        info = read_json(f, {}) or {}
        pid, sid = info.get("pid"), info.get("sessionId")
        if not sid or not proc_alive(pid, info.get("procStart")) or is_headless(pid):
            continue
        rec = read_json(LIVE / f"{sid}.json")
        if rec is None or (rec.get("pid") == pid and not rec.get("ended") and rec.get("name") != info.get("name")):
            ledger_update(sid, pid, lastCwd=info.get("cwd"))
    for f in LIVE.glob("*.json"):
        rec = read_json(f, {}) or {}
        if rec.get("ended") and time.time() - rec["ended"] > 86400:
            f.unlink(missing_ok=True)


def interrupted_sessions():
    """Sessions whose process is gone without having ended: newest activity first. Those
    that were waiting on you, not working, come back with cause "standby"."""
    live, live_jobs = set(), set()
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        info = read_json(f, {}) or {}
        if proc_alive(info.get("pid"), info.get("procStart")):
            live.add(info.get("sessionId"))
            live_jobs.add(info.get("jobId"))
    out, boot = [], boot_id()
    for f in LIVE.glob("*.json"):
        rec = read_json(f)
        if not rec or rec.get("ended") or rec.get("sessionId") in live:
            continue
        if rec.get("jobId") and rec["jobId"] in live_jobs:  # its background job is running again
            continue
        if rec.get("kind") == "bg" and rec.get("jobId") and not (CLAUDE_DIR / "jobs" / rec["jobId"]).is_dir():
            # a crash or reboot leaves the job dir; only `claude rm` (closed, anywhere) removes it
            rec.update(ended=time.time(), endReason="removed")
            write_json(f, rec)
            continue
        if rec.get("bootId") == boot and proc_alive(rec.get("pid"), rec.get("procStart")):
            continue
        rec["path"] = str(f)
        rec["cause"] = "reboot" if rec.get("bootId") != boot else "crashed"
        job = read_json(CLAUDE_DIR / "jobs" / str(rec.get("jobId")) / "state.json", {}) or {}
        if rec.get("kind") == "bg" and job.get("state") not in (None, "working", "failed"):
            # Claude parks a background session that sits waiting on you, and a reboot does the
            # same to one that wasn't mid-task: nothing was lost, it's on standby.
            rec.update(cause="standby", jobState=job["state"], needs=job.get("needs") or job.get("detail") or "")
        out.append(rec)
    out.sort(key=lambda r: -(r.get("lastActive") or r.get("seenAt") or 0))
    best = {}  # one row per background job, the record that holds its conversation
    for r in out:
        if r.get("jobId") and (r["jobId"] not in best or r.get("firstPrompt") and not best[r["jobId"]].get("firstPrompt")):
            best[r["jobId"]] = r
    return [r for r in out if not r.get("jobId") or best[r["jobId"]] is r]


def lost_label(r):
    return r.get("name") or r.get("firstPrompt") or Path(r.get("cwd", "")).name or r["sessionId"][:8]


def cmd_web(args):
    """The phone app: planeweb.py, next to this file, reusing this module."""
    sys.path.insert(0, str(Path(SELF).parent))
    import planeweb
    planeweb.serve(sys.modules[__name__], args.port)


def cmd_recover(args):
    """Login reminder: a notification that stays until clicked, listing what was left open."""
    time.sleep(args.delay)  # let the notification daemon come up first
    lost = [r for r in interrupted_sessions() if r["cause"] != "standby"]
    waiting = [h for h in (read_json(f) for f in sorted(HANDOFFS.glob("*.json"))) if h]
    if not lost and not waiting:
        return
    title = " · ".join(filter(None, (
        f"{len(lost)} session{'s' * (len(lost) != 1)} cut off" if lost else "",
        f"{len(waiting)} handoff{'s' * (len(waiting) != 1)} waiting" if waiting else "")))
    lines = [f"↯ {lost_label(r)[:50]}" for r in lost[:6]] + [f"→ {h.get('title', '?')[:50]}" for h in waiting[:6]]
    r = subprocess.run(["notify-send", "-a", "Plane", "-i", "plane", "-u", "critical", "-A", "open=Open Plane",
                        title, "\n".join(lines)], capture_output=True, text=True)
    if r.stdout.strip() == "open":
        cmd_open(None)


# ---------------------------------------------------------------- data

def git_branch(cwd):
    m = re.search(r"/\.(?:claude/)?worktrees/([^/]+)", cwd)
    if m:
        return m.group(1)
    git = Path(cwd) / ".git"
    try:
        if git.is_file():
            git = Path(git.read_text().split("gitdir:", 1)[1].strip())
        head = (git / "HEAD").read_text().strip()
        return head.rsplit("/", 1)[-1] if head.startswith("ref:") else head[:8]
    except (OSError, IndexError):
        return ""


def recent_projects(limit=10):
    seen = []
    try:
        lines = (CLAUDE_DIR / "history.jsonl").read_text(errors="replace").splitlines()
    except OSError:
        return seen
    for line in reversed(lines):
        try:
            p = json.loads(line).get("project")
        except ValueError:
            continue
        if not p or p in seen or p == str(HOME) or "/.worktrees/" in p:
            continue
        if Path(p).is_dir():
            seen.append(p)
        if len(seen) >= limit:
            break
    return seen


def complete_dir(text):
    """Extend a typed path to the longest folder prefix it uniquely starts."""
    base = os.path.expanduser(text or "~/")
    parent, stem = os.path.split(base)
    try:
        names = sorted(e.name for e in os.scandir(parent or ".") if e.is_dir()
                       and e.name.startswith(stem) and (stem.startswith(".") or not e.name.startswith(".")))
    except OSError:
        return text
    if not names:
        return text
    common = os.path.commonprefix(names)
    done = os.path.join(parent, common) + ("/" if len(names) == 1 else "")
    return done.replace(str(HOME), "~", 1) if text.startswith("~") or not text else done


def session_state(s):
    """What the sidebar says about a session: working, needs you, your turn, paused or failed."""
    if s.get("stopped"):
        return "failed" if s.get("state") == "failed" else "paused"
    if not s["bg"] or not s.get("procStatus"):
        if s.get("status") == "busy":
            return "working"
        return "needs you" if s["bg"] and s.get("state") == "blocked" else "your turn"
    # A background session reports "busy" (`claude agents`) for as long as any of its tasks
    # runs, a background shell or a CI watch included, even after its turn has ended with a
    # question for you. Its own status file tells "busy" (thinking) from "shell" (only a task
    # running), and its job file says whether the turn ended blocked on you.
    proc, job, tempo = s["procStatus"], s.get("jobState"), s.get("tempo")
    if proc == "waiting":  # a permission prompt
        return "needs you"
    if proc == "busy":
        return "working"
    if tempo == "blocked" or (job == "blocked" and tempo != "active"):
        return "needs you"
    if proc == "shell" and job == "working":  # waiting on its own task; it carries on after
        return "working"
    return "your turn"


def last_used(s):
    """When you last used a session: your last message to it (the ledger's lastActive), or
    its start. Opening one doesn't count: browsing would reshuffle the list under you."""
    rec = read_json(LIVE / f"{s.get('sessionId')}.json", {}) or {} if s.get("sessionId") else {}
    started = (s.get("startedAt") or 0) / 1000
    return max(rec.get("lastActive") or 0, started)


def changes_signature():
    """Changes whenever a session's status, a job's state, the ledger, the handoff queue or
    the usage numbers change: the files and their modification times."""
    files = [*(CLAUDE_DIR / "sessions").glob("*.json"), *(CLAUDE_DIR / "jobs").glob("*/state.json"),
             *LIVE.glob("*.json"), *HANDOFFS.glob("*.json"), USAGE]
    sig = []
    for f in files:
        try:
            sig.append((str(f), f.stat().st_mtime_ns))
        except OSError:
            pass
    return sorted(sig)


def close_notification(nid):
    if not nid or not str(nid).isdigit():
        return
    try:
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                        "--object-path", "/org/freedesktop/Notifications",
                        "--method", "org.freedesktop.Notifications.CloseNotification", str(nid)],
                       capture_output=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass


def phone_watching():
    """The phone app is open right now (`plane web` touches the flag every few seconds)."""
    try:
        return time.time() - PHONE_FLAG.stat().st_mtime < 20
    except OSError:
        return False


def purge_discarded():
    """Delete discarded handoffs older than DISCARD_KEEP_DAYS (their file time is the discard time)."""
    cutoff = time.time() - DISCARD_KEEP_DAYS * 86400
    for f in DISCARDED.glob("*.json"):
        try:
            if f.stat().st_mtime < cutoff:
                f.unlink()
        except OSError:
            pass


class Store:
    """Polls sessions, handoffs and usage on a background thread."""

    def __init__(self, on_ready, on_waiting, on_settled):
        self.lock = threading.Lock()
        self.sessions, self.handoffs, self.usage, self.lost = [], [], {}, []
        self.error = ""
        self.on_ready = on_ready
        self.on_waiting = on_waiting
        self.on_settled = on_settled
        self._ready_seen = None
        self._state_seen = None
        self._wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def poke(self):
        self._wake.set()

    def _loop(self):
        purged = 0.0
        while True:
            if time.time() - purged > 3600:
                purge_discarded()
                purged = time.time()
            try:
                self._refresh()
            except Exception as exc:  # keep polling whatever happens
                self.error = f"refresh: {exc}"
            # `claude agents` costs ~0.4 s of CPU, so don't run it on a timer: watch the files
            # sessions write when their state changes (a stat each, every 0.3 s) and refresh
            # as soon as one does, with a full refresh every 10 s as a backstop
            seen, since = changes_signature(), time.time()
            while not self._wake.wait(0.3):
                if changes_signature() != seen or time.time() - since > 10:
                    break
            self._wake.clear()
            time.sleep(max(0.0, since + 1 - time.time()))  # at most one refresh a second

    def _refresh(self):
        out = subprocess.run([claude_bin(), "agents", "--json", "--all"],
                             capture_output=True, text=True, timeout=15)
        raw = json.loads(out.stdout or "[]")
        sessions, stopped = [], []
        for s in raw:
            bg = s.get("kind") == "background"
            s["bg"] = bg
            s["branch"] = git_branch(s.get("cwd", ""))
            files = read_json(CLAUDE_DIR / "sessions" / f"{s.get('pid')}.json", {}) or {} if s.get("pid") else {}
            s["procStart"] = files.get("procStart")
            if bg:
                job = read_json(CLAUDE_DIR / "jobs" / s["id"] / "state.json", {}) or {}
                s["needs"] = job.get("needs") or job.get("detail") or ""
                s["procStatus"] = files.get("status")  # busy / shell / waiting / idle
                s["jobState"], s["tempo"] = job.get("state"), job.get("tempo")
            alive = bool(s.get("pid")) and Path(f"/proc/{s['pid']}").exists()
            (sessions if alive else stopped).append(s)
        for s in sessions + stopped:
            s["usedAt"] = last_used(s)
        sessions.sort(key=lambda s: (not s["bg"], -s["usedAt"]))  # most recently used first
        ledger_sync()
        lost = interrupted_sessions()
        lost_ids = {r["sessionId"] for r in lost}
        stopped = [s for s in stopped if s.get("sessionId") not in lost_ids]  # listed as interrupted
        stopped.sort(key=lambda s: -s.get("startedAt", 0))
        for s in stopped:
            s["stopped"] = True

        handoffs = []
        for f in sorted(HANDOFFS.glob("*.json")):
            h = read_json(f)
            if not h:
                continue
            h["path"] = str(f)
            src = next((s for s in sessions if s.get("pid") == h.get("sourcePid")
                        and (not h.get("sourceProcStart") or s.get("procStart") == h["sourceProcStart"])),
                       None) or next((s for s in sessions if s.get("sessionId") == h.get("sourceSessionId")), None)
            h["source"] = src
            h["ready"] = src is None or src.get("status") != "busy"
            handoffs.append(h)

        ready_now = {h["id"] for h in handoffs if h["ready"]}
        if self._ready_seen is not None:
            for h in handoffs:
                if h["id"] in ready_now - self._ready_seen:
                    self.on_ready(h)
        self._ready_seen = ready_now

        # a background session that just stopped working is waiting on you
        states = {s["id"]: session_state(s) for s in sessions if s["bg"]}
        if self._state_seen is not None:
            for s in sessions:
                state, before = states.get(s.get("id")), self._state_seen.get(s.get("id"))
                if state in ("needs you", "your turn") and before not in (None, state):
                    self.on_waiting(s, state)
            parked = {r.get("jobId") for r in lost if r["cause"] == "standby"}  # still waiting on you
            for sid, before in self._state_seen.items():
                # it went back to work, was paused or closed: its notification is out of date
                now = states.get(sid)
                if before in ("needs you", "your turn") and now not in ("needs you", "your turn") \
                        and not (now is None and sid in parked):
                    self.on_settled(sid)
        self._state_seen = states

        with self.lock:
            self.sessions = sessions + stopped
            self.handoffs = handoffs
            self.lost = lost
            self.usage = read_json(USAGE, {}) or {}
            self.error = "" if out.returncode == 0 else (out.stderr.strip()[:80] or "claude agents failed")


# ---------------------------------------------------------------- source control
# Push and pull each project's main checkout, the way VS Code's Source Control does: the
# branch, what's waiting to come down (↓) and go up (↑), uncommitted changes (*), and a
# fetch every few minutes so ↓ stays true.

AUTOFETCH_SECS = 180  # VS Code's git.autofetchPeriod


def parse_git_status(text):
    """`git status --porcelain=v2 --branch` -> branch, upstream, ahead, behind, changes."""
    info = {"branch": "", "upstream": "", "ahead": 0, "behind": 0, "changes": 0}
    for line in text.splitlines():
        if line.startswith("# branch.head "):
            head = line[len("# branch.head "):].strip()
            info["branch"] = "" if head == "(detached)" else head
        elif line.startswith("# branch.upstream "):
            info["upstream"] = line[len("# branch.upstream "):].strip()
        elif line.startswith("# branch.ab "):
            for part in line.split()[2:]:
                if part[:1] in "+-" and part[1:].isdigit():
                    info["ahead" if part[0] == "+" else "behind"] = int(part[1:])
        elif line and not line.startswith("#"):
            info["changes"] += 1
    return info


def git_error(out):
    """The line of git's output that says what went wrong, without its hint lines."""
    lines = [ln.strip() for ln in out.splitlines() if ln.strip() and not ln.lstrip().startswith("hint:")]
    for ln in lines:
        if ln.lower().startswith(("fatal:", "error:", "! [rejected]", "! [remote rejected]")):
            return ln
    return lines[-1] if lines else "git failed"


def git(path, *args, timeout=20):
    """Run git with no terminal to prompt on: a missing password or passphrase fails with a
    message instead of hanging the sidebar (or writing over it)."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never", LC_ALL="C")
    try:
        r = subprocess.run(["git", "--no-optional-locks", "-C", path, *args], capture_output=True, text=True,
                           timeout=timeout, env=env, stdin=subprocess.DEVNULL, start_new_session=True)
        return r.returncode, (r.stdout + r.stderr).strip()
    except subprocess.TimeoutExpired:
        return 124, f"error: git {args[0]} took over {timeout} s (is the network up?)"
    except OSError as exc:
        return 127, f"error: {exc}"


def git_toplevel(path):
    """The main checkout a folder belongs to (a worktree counts as its main checkout), or ''."""
    code, out = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir", timeout=5)
    if code != 0 or not out:
        return ""
    common = Path(out.splitlines()[-1])
    return str(common.parent) if common.name == ".git" else ""  # a bare repo has no checkout


class Repos:
    """Polls `git status` for every project with a session or a handoff, fetches every few
    minutes, and runs pull/push/sync on their own threads so the sidebar never waits."""

    def __init__(self, candidates, on_done):
        self.lock = threading.Lock()
        self.repos = {}      # main checkout path -> status dict
        self.roots = {}      # folder -> its main checkout ('' when not in a repo)
        self.candidates = candidates  # () -> folders sessions and handoffs are in
        self.on_done = on_done        # (text, tone) when an action finishes
        self._wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def poke(self):
        self._wake.set()

    def snapshot(self):
        with self.lock:
            return sorted((dict(r) for r in self.repos.values()), key=lambda r: r["name"].lower())

    def _loop(self):
        while True:
            try:  # one bad pass (a repo mid-rebase, a folder that vanished) must not end polling
                self._refresh()
            except Exception as exc:
                dbg(f"repos refresh: {exc}")
            self._wake.wait(5)
            self._wake.clear()

    def _refresh(self):
        roots = set()
        for folder in set(self.candidates()):
            if folder not in self.roots:
                self.roots[folder] = git_toplevel(folder) if Path(folder).is_dir() else ""
            if self.roots[folder]:
                roots.add(self.roots[folder])
        for root in roots:
            self._status(root)
            with self.lock:
                r = self.repos.get(root, {})
                due = (r.get("remote") and not r.get("busy")
                       and time.time() - r.get("fetchedAt", 0) > AUTOFETCH_SECS)
            if due:  # quietly: a failed autofetch is retried next period, not reported
                code, _ = git(root, "fetch", "--quiet", timeout=60)
                with self.lock:
                    self.repos[root]["fetchedAt"] = time.time()
                    if code == 0:
                        self.repos[root]["checkedAt"] = time.time()
                self._status(root)
        with self.lock:
            for gone in set(self.repos) - roots:
                if not self.repos[gone].get("busy"):
                    del self.repos[gone]

    def _status(self, root):
        code, out = git(root, "status", "--porcelain=v2", "--branch", timeout=10)
        rcode, remotes = git(root, "remote", timeout=5)
        names = remotes.split() if rcode == 0 else []
        with self.lock:
            r = self.repos.setdefault(root, {"id": root, "path": root, "name": Path(root).name or root,
                                             "busy": "", "error": "", "fetchedAt": 0, "checkedAt": 0})
            if code == 0:
                r.update(parse_git_status(out))
            r["remote"] = "origin" if "origin" in names else (names[0] if names else "")

    def run(self, root, action):
        """Start pull / push / sync / fetch on `root`. False when it's already busy."""
        with self.lock:
            r = self.repos.get(root)
            if not r or r.get("busy"):
                return False
            r["busy"], r["error"] = action, ""
        threading.Thread(target=self._run, args=(root, action), daemon=True).start()
        return True

    def _run(self, root, action):
        name = Path(root).name
        with self.lock:
            r = dict(self.repos.get(root, {}))
        steps = []
        if action == "fetch":
            steps = [("fetch", ["fetch", "--prune"])]
        elif not r.get("upstream"):
            if action in ("push", "sync") and r.get("remote") and r.get("branch"):
                # VS Code's "Publish Branch": push it and set it to track the remote
                steps = [("publish", ["push", "-u", r["remote"], r["branch"]])]
        else:
            if action in ("pull", "sync"):
                steps.append(("pull", ["pull"]))
            if action in ("push", "sync"):
                steps.append(("push", ["push"]))
        if not steps:
            why = ("it has no remote to push to" if not r.get("remote") else
                   "it isn't on a branch" if not r.get("branch") else "its branch isn't on GitHub yet: push publishes it")
            self._finish(root, "", f"{name}: nothing to {action}, {why}", "warn")
            return
        before = (r.get("behind", 0), r.get("ahead", 0))
        for step, args in steps:
            code, out = git(root, *args, timeout=120)
            if code != 0:
                err = git_error(out)
                self._finish(root, err, f"{name}: {step} failed · {err}", "bad")
                return
        self._status(root)
        with self.lock:
            now = self.repos.get(root, {})
            now["checkedAt"] = now["fetchedAt"] = time.time()
            after = (now.get("behind", 0), now.get("ahead", 0))
        done = {"fetch": f"fetched · ↓{after[0]} ↑{after[1]}", "pull": f"pulled {before[0]}" if before[0] else "pulled (was up to date)",
                "push": f"pushed {before[1]}" if before[1] else "pushed (nothing new)",
                "sync": "in sync" if after == (0, 0) else f"↓{after[0]} ↑{after[1]} left"}
        text = "published" if steps[0][0] == "publish" else done[action]
        self._finish(root, "", f"{name}: {text}", "info")

    def _finish(self, root, error, text, tone):
        self._status(root)
        self.on_done(text, tone)
        with self.lock:  # last, so the row stops saying "pulling…" only once it's all done
            r = self.repos.get(root)
            if r:
                r["busy"], r["error"] = "", error


