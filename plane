def dbg(text):
    """Event log for troubleshooting, only with PLANE_DEBUG=1: ~/.cache/plane/debug.log."""
    if not os.environ.get("PLANE_DEBUG"):
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(CACHE / "debug.log", "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} [{os.getpid()}] {text}\n")


def kitty(*args):
    if args and args[0] in ("focus-window", "launch", "close-window", "send-text"):
        dbg(f"kitty {args[:4]}")
    to = os.environ.get("KITTY_LISTEN_ON") or f"unix:{SOCK}"
    return subprocess.run(["kitty", "@", "--to", to, *args], capture_output=True, text=True, timeout=10)


def kitty_windows():
    try:
        data = json.loads(kitty("ls").stdout)
    except ValueError:
        return []
    return [w for o in data for t in o["tabs"] for w in t["windows"]]


def attached_id():
    for w in kitty_windows():
        if w.get("user_vars", {}).get("plane_role") == "session":
            return w["user_vars"].get("plane_id")
    return None


def show_in_pane(cmd, cwd, title, pane_id=""):
    """Replace the right-hand pane with `cmd` (closing it only detaches)."""
    kitty("close-window", "--match", "var:plane_role=session")
    r = kitty("launch", "--type=window", "--location=vsplit",
              "--var", "plane_role=session", "--var", f"plane_id={pane_id}",
              "--cwd", cwd, "--title", title, *cmd)
    fit_sidebar()
    return r.returncode == 0


# A width the user dragged the sidebar to: kept while the Plane window stays the same size,
# dropped (back to the default) once the window itself is resized.
dragged = {"cols": None, "total": None}


def split_cols():
    """(sidebar columns, both panes' columns), or None while there's no session pane."""
    wins = kitty_windows()
    me = os.environ.get("KITTY_WINDOW_ID")
    cols = next((w["columns"] for w in wins if str(w["id"]) == me), None)
    if len(wins) < 2 or cols is None:
        return None
    return cols, sum(w["columns"] for w in wins)


def same_window(total, other):
    return other is not None and abs(total - other) <= 1  # the two panes' sum wobbles by a cell


def default_cols(total):
    return SIDEBAR_COLS if total >= 110 else max(24, round(total * 0.34))


def fit_sidebar():
    """Pin the sidebar's width; kitty otherwise rescales both panes on every resize."""
    me = os.environ.get("KITTY_WINDOW_ID")
    for _ in range(3):  # resizes land in steps; nudge until it sits at the target
        now = split_cols()
        if not now:
            return
        cols, total = now
        target = dragged["cols"] if dragged["cols"] and same_window(total, dragged["total"]) else default_cols(total)
        if abs(cols - target) <= 1:
            return
        kitty("resize-window", "--match", f"id:{me}", "--axis", "horizontal",
              "--increment", str(target - cols))


def settle_resize(last_total):
    """After the sidebar's size changed: if the window is the same size, the user dragged the
    split, so keep that width; if the window changed size, go back to the default width.
    Returns the panes' total width, to compare against next time."""
    now = split_cols()
    if not now:
        return last_total
    cols, total = now
    if same_window(total, last_total):
        keep = abs(cols - default_cols(total)) > 1
        dragged.update(cols=cols if keep else None, total=total if keep else None)
    else:
        dragged.update(cols=None, total=None)
        fit_sidebar()
    return total


