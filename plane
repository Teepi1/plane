C_OK, C_WARN, C_BAD, C_ACCENT, C_DIM, C_TEXT = 1, 2, 3, 4, 5, 6
SEL = 10  # pair + SEL: the same color on the selected row's band
PASTE_START, PASTE_END = "[200~", "\x1b[201~"
FOCUS_IN, FOCUS_OUT = -1001, -1002  # what read() returns for the terminal's focus reports
TONES = {"info": C_ACCENT, "warn": C_WARN, "bad": C_BAD}
TREE = CACHE / "tree.json"  # the handoff projects and folders you left open
NEW_FOLDER = "\0new"       # the "New folder…" choice in a handoff's Folders…


def short_needs(text, limit=140):
    """What a blocked session is asking, short enough to read: a tool approval keeps the
    tool's name and the start of its first line, not a whole script."""
    text = " ".join(str(text or "").split("\n")[0].split())
    return text if len(text) <= limit else text[:limit - 1].rstrip() + "…"


def wrap(text, width, max_lines=3):
    """Word-wrap one line of detail text into at most `max_lines` lines."""
    words, lines, cur = text.split(), [], ""
    for word in words:
        while len(word) > width:  # a path or command longer than the line
            if cur:
                lines.append(cur)
                cur = ""
            lines.append(word[:width])
            word = word[width:]
        if not cur:
            cur = word
        elif len(cur) + 1 + len(word) <= width:
            cur += " " + word
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = lines[-1][:width - 1].rstrip() + "…"
    return lines or [""]


class Paste(str):
    """Text that arrived as a bracketed paste, never to be read as key commands."""


def fmt_reset(reset):
    if reset is None:
        return ""
    try:
        if isinstance(reset, (int, float)):
            t = datetime.fromtimestamp(reset / 1000 if reset > 1e12 else reset, timezone.utc)
        else:
            t = datetime.fromisoformat(str(reset).replace("Z", "+00:00"))
    except ValueError:
        return ""
    secs = (t - datetime.now(timezone.utc)).total_seconds()
    if secs <= 0:
        return "now"
    if secs < 86400:
        h, m = divmod(int(secs // 60), 60)
        return f"{h}h{m:02d}m" if h else f"{m}m"
    return t.astimezone().strftime("%a %H:%M")


def ago(ts):
    secs = max(0, time.time() - ts)
    if secs < 90:
        return "just now"
    if secs < 3600:
        return f"{int(secs // 60)}m ago"
    if secs < 86400:
        return f"{int(secs // 3600)}h ago"
    return f"{int(secs // 86400)}d ago"


class Sidebar:
    def __init__(self, scr):
        self.scr = scr
        self.sel = 0
        self.items = []      # (kind, obj)
        self.rows = {}       # screen row -> item index
        self.msg, self.msg_at, self.msg_tone = "", 0, "info"
        self.sel_key = None       # the selected item's identity, so a refresh can't move the selection
        self.last_discard = None  # path in discarded/, for u to bring it back
        self.tree_open = {tuple(k) for k in read_json(TREE, []) or [] if isinstance(k, list) and len(k) == 2}
        self.depths = []            # each item's depth in the handoff tree (0 elsewhere)
        self.pending_key = None     # an item to select on the next draw
        self.last_click = (None, 0)
        self.attached = None
        self.open_request = None  # session id from a notification's Open button
        self.notes = {}           # session id -> its notification's id, so a newer one replaces it
        self.clear_stale_notes()
        self.store = Store(self.notify_ready, self.notify_waiting, self.clear_note)
        self.repos = Repos(self.repo_folders, self.flash)
        curses.curs_set(0)
        curses.use_default_colors()
        # The selected row sits on a band of the theme's color 0, a step up from the
        # background in dark themes; its text uses color 15 so it reads in light themes too.
        bright = 15 if curses.COLORS >= 16 else curses.COLOR_WHITE
        for i, c in ((C_OK, curses.COLOR_GREEN), (C_WARN, curses.COLOR_YELLOW),
                     (C_BAD, curses.COLOR_RED), (C_ACCENT, curses.COLOR_CYAN),
                     (C_DIM, curses.COLOR_WHITE), (C_TEXT, -1)):
            curses.init_pair(i, c, -1)
            curses.init_pair(i + SEL, bright if c == -1 else c, curses.COLOR_BLACK)
        curses.mousemask(curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED
                         | curses.BUTTON3_CLICKED | curses.BUTTON3_PRESSED
                         | curses.BUTTON4_PRESSED | getattr(curses, "BUTTON5_PRESSED", 0))
        curses.mouseinterval(0)
        self.tmo = 400
        scr.timeout(self.tmo)
        scr.keypad(True)
        # bracketed paste: pastes arrive marked, not as keystrokes; focus reports: the terminal
        # says when you move into or out of the sidebar
        sys.stdout.write("\x1b[?2004h\x1b[?1004h")
        sys.stdout.flush()
        self.focused = True  # it starts focused: it's the window that was just opened
        self.shown = {}      # item key -> its position on screen, last time it was drawn
        self.last_keys, self.prev_keys, self.moved_at = [], [], 0.0  # the list's order, and when it last changed
        self.own_change = False  # the next change to the list is one you just made
        self.resized_at = 0
        self.split_total = None  # both panes' width when last settled: tells a drag from a window resize

    def set_timeout(self, ms):
        self.tmo = ms
        self.scr.timeout(ms)

    def read(self):
        """Next key: an int (special/ord), or a Paste. Raises curses.error on timeout.
        Focus reports are taken here (they set self.focused) and never returned as keys."""
        while True:
            ch = self._read_one()
            if isinstance(ch, int) and ch >= 512 and not isinstance(ch, Paste):
                # ncurses turns the focus report into a key of its own when the terminfo
                # names it (kitty's and xterm's do), with a code that differs between them
                try:
                    ch = {b"kxIN": FOCUS_IN, b"kxOUT": FOCUS_OUT}.get(curses.keyname(ch), ch)
                except ValueError:
                    pass
            if ch not in (FOCUS_IN, FOCUS_OUT):
                return ch
            self.focused = ch == FOCUS_IN
            dbg(f"focus {'in' if self.focused else 'out'}")

    def _read_one(self):
        ch = self.scr.get_wch()
        if ch != "\x1b":
            return ord(ch) if isinstance(ch, str) else ch
        self.scr.timeout(30)
        try:
            seq = ""
            while PASTE_START.startswith(seq) and seq != PASTE_START:
                try:
                    c = self.scr.get_wch()
                except curses.error:
                    break
                seq += c if isinstance(c, str) else "?"
            if seq in ("[I", "[O"):  # kitty's focus report (mode 1004)
                return FOCUS_IN if seq == "[I" else FOCUS_OUT
            if seq != PASTE_START:
                return 27  # a plain Esc (an unknown sequence after it is dropped)
            buf, deadline = "", time.time() + 3
            while not buf.endswith(PASTE_END) and time.time() < deadline:
                try:
                    c = self.scr.get_wch()
                except curses.error:
                    continue
                if isinstance(c, str):
                    buf += c
            return Paste(buf[:-len(PASTE_END)] if buf.endswith(PASTE_END) else buf)
        finally:
            self.scr.timeout(self.tmo)

    def forward_paste(self, text):
        """A paste in the sidebar was meant for the session: send it there."""
        if not attached_id():
            self.flash("open a session first; pastes go into the session", "warn")
            return
        kitty("send-text", "--match", "var:plane_role=session", "--bracketed-paste", "auto", "--", text)
        kitty("focus-window", "--match", "var:plane_role=session")

    # -- helpers
    def flash(self, text, tone="info"):
        """A short message above the key hints: info (done, or what happens next), warn, or bad."""
        self.msg, self.msg_at, self.msg_tone = text, time.time(), tone

    def notify_ready(self, h):
        if phone_watching():  # the phone shows it
            return
        subprocess.Popen(["notify-send", "-a", "Plane", "-i", "plane", "Handoff ready", h.get("title", "")],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def notify_waiting(self, s, state):
        """Called on the poll thread. Skipped while you're looking at Plane, on this screen or
        in the phone app: it shows there."""
        if phone_watching():
            return
        try:
            if json.loads(hypr("activewindow", "-j").stdout or "{}").get("class") == CLASS:
                return
        except ValueError:
            pass
        sid = s["id"]
        name = s.get("name") or sid
        title = f"{name} needs you" if state == "needs you" else f"Your turn: {name}"
        cmd = ["notify-send", "-a", "Plane", "-i", "plane", "-p", "-A", "open=Open",
               title, short_needs(s.get("needs")) if state == "needs you" else ""]
        old = self.notes.get(sid)
        if old and old.get("id"):
            cmd[1:1] = ["-r", old["id"]]  # one notification per session, updated in place
        threading.Thread(target=self._notification, args=(sid, cmd, old), daemon=True).start()

    def _notification(self, sid, cmd, old):
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return
        note = {"proc": proc, "id": proc.stdout.readline().strip()}  # -p prints the id now, the action on click
        self.notes[sid] = note
        if old and old.get("proc"):
            old["proc"].kill()  # the replaced notification's waiter would otherwise wait forever
        self.save_notes()
        if proc.stdout.readline().strip() == "open":
            hypr_focus(f"class:^({CLASS})$")
            self.open_request = sid
        proc.wait()
        if self.notes.get(sid) is note:
            self.notes.pop(sid, None)
            self.save_notes()

    def save_notes(self):
        write_json(NOTES, {sid: n["id"] for sid, n in list(self.notes.items()) if n.get("id")})

    def clear_note(self, sid):
        """Take back a session's notification: it was opened, or it's no longer waiting on you.
        Without this, a stale "Your turn" stays up until you click it."""
        note = self.notes.pop(sid, None)
        if not note:
            return
        self.save_notes()
        close_notification(note.get("id"))
        if note.get("proc"):
            note["proc"].kill()

    def clear_stale_notes(self):
        """At start: notifications from before a restart or reload can't be answered any more
        (nothing is listening for their Open button), so take them all back."""
        for nid in (read_json(NOTES, {}) or {}).values():
            close_notification(nid)
        NOTES.unlink(missing_ok=True)
        for pid in os.listdir("/proc"):
            argv = cmdline(pid) if pid.isdigit() else []
            if argv and Path(argv[0]).name == "notify-send" and "Plane" in argv and "-p" in argv:
                try:
                    os.kill(int(pid), 15)
                except OSError:
                    pass

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addnstr(y, x, text, max(0, w - x - 1), attr)
            except curses.error:
                pass

    def ask(self, question, default="", complete=None, hint="esc cancels"):
        """One-line input at the bottom. Returns None on Esc; Tab runs `complete`."""
        self.draw()  # the list stays in view above the input (a chooser may have covered it)
        h, w = self.scr.getmaxyx()
        buf = list(default)
        curses.curs_set(1)
        self.set_timeout(-1)
        try:
            while True:
                text = "".join(buf)
                for y in (h - 4, h - 3, h - 2, h - 1):
                    self.put(y, 0, " " * w)
                self.put(h - 4, 1, question[:w - 2], curses.color_pair(C_ACCENT) | curses.A_BOLD)
                shown = text[-(w - 5):]
                self.put(h - 3, 1, "›", curses.color_pair(C_ACCENT) | curses.A_BOLD)
                self.put(h - 3, 3, shown.ljust(w - 5), curses.color_pair(C_TEXT + SEL))
                self.put(h - 1, 1, hint[:w - 2], curses.A_DIM)
                self.scr.move(h - 3, min(w - 2, 3 + len(shown)))
                ch = self.read()
                if isinstance(ch, Paste):
                    buf.extend(c for c in " ".join(ch.split()) if c.isprintable())
                elif ch in (10, 13, curses.KEY_ENTER):
                    return text.strip()
                elif ch == 27:
                    return None
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    if buf:
                        buf.pop()
                elif ch == 21:  # ctrl+u
                    buf.clear()
                elif ch == 9 and complete:
                    buf = list(complete(text))
                elif isinstance(ch, int) and 32 <= ch < 0x110000 and chr(ch).isprintable():
                    buf.append(chr(ch))
        finally:
            curses.curs_set(0)
            self.set_timeout(400)

    def confirm(self, question, yes="yes"):
        """One keypress: y does it, anything else (n, Esc, a click) backs out."""
        h, w = self.scr.getmaxyx()
        self.draw()
        for y in (h - 3, h - 2, h - 1):
            self.put(y, 0, " " * w)
        self.put(h - 3, 1, question[:w - 2], curses.color_pair(C_WARN) | curses.A_BOLD)
        self.put(h - 2, 1, "y", curses.A_BOLD)
        self.put(h - 2, 3, yes)
        self.put(h - 2, 5 + len(yes), "n", curses.A_BOLD)
        self.put(h - 2, 7 + len(yes), "cancel", curses.A_DIM)
        self.scr.refresh()
        self.set_timeout(-1)
        try:
            while True:
                ch = self.read()
                if ch == curses.KEY_MOUSE:
                    try:  # drain it and keep waiting: the release of the click that
                        curses.getmouse()  # picked a menu item arrives here too
                    except curses.error:
                        pass
                elif ch == curses.KEY_RESIZE:
                    continue
                return not isinstance(ch, Paste) and ch in (ord("y"), ord("Y"))
        finally:
            self.set_timeout(400)

    def choose(self, title, options, step="", start=0, hint="esc cancels"):
        """Pick from a short list with arrows/Enter, or type. Returns str or None.
        Options are (label, value) or (label, value, note): the note is shown dim after it."""
        idx = max(0, min(start, len(options) - 1))
        self.set_timeout(-1)
        try:
            while True:
                self.scr.erase()
                w = self.scr.getmaxyx()[1]
                if step:
                    self.put(0, 1, step, curses.A_DIM)
                self.put(1, 1, title, curses.color_pair(C_ACCENT) | curses.A_BOLD)
                for i, (label, _val, *note) in enumerate(options):
                    sel = i == idx
                    self.put(3 + i, 0, " " * (w - 1), curses.color_pair(C_TEXT + SEL) if sel else 0)
                    if sel:
                        self.put(3 + i, 0, "▌", curses.color_pair(C_ACCENT + SEL))
                    self.put(3 + i, 2, label, curses.color_pair(C_TEXT + SEL if sel else C_TEXT) | (curses.A_BOLD if sel else 0))
                    if note and len(label) + 4 < w - 2:
                        self.put(3 + i, 3 + len(label), note[0][:w - len(label) - 5],
                                 curses.color_pair(C_DIM + SEL if sel else C_DIM) | curses.A_DIM)
                self.put(4 + len(options), 1, hint, curses.A_DIM)
                self.scr.refresh()
                ch = self.read()
                if isinstance(ch, Paste):
                    continue
                if ch in (curses.KEY_UP, ord("k")):
                    idx = (idx - 1) % len(options)
                elif ch in (curses.KEY_DOWN, ord("j")):
                    idx = (idx + 1) % len(options)
                elif ch in (10, 13, curses.KEY_ENTER):
                    return options[idx][1]
                elif ch == 27:
                    return None
                elif ch == curses.KEY_MOUSE:
                    try:
                        _, _, my, _, _ = curses.getmouse()
                    except curses.error:
                        continue
                    if 0 <= my - 3 < len(options):
                        return options[my - 3][1]
        finally:
            self.set_timeout(400)

    def run_claude(self, args, cwd):
        r = subprocess.run([claude_bin(), *args], cwd=cwd, capture_output=True, text=True, timeout=60)
        return r.returncode, (r.stdout + r.stderr).strip()

    # -- actions
    def attach(self, s):
        if not s["bg"]:
            pid, pids = s["pid"], {c.get("pid") for c in hypr_clients()}
            while pid > 1 and pid not in pids:
                pid = ppid_of(pid)
            if in_phone_terminal(s["pid"]):
                self.flash("it's running in the phone app's Terminal tab")
            elif pid > 1:
                hypr_focus(f"pid:{pid}")
            elif not shutil.which("hyprctl"):
                self.flash("it's in another window (switching to it needs Hyprland)")
            else:
                self.flash("couldn't find that session's window", "bad")
            return
        self.clear_note(s["id"])  # you're looking at it now: its "your turn" note is done
        if self.attached == s["id"]:
            kitty("focus-window", "--match", "var:plane_role=session")
            return
        if show_in_pane([claude_bin(), "attach", s["id"]], s.get("cwd", str(HOME)),
                        s.get("name") or s["id"], s["id"]):
            self.attached = s["id"]
            self.store.poke()  # fresh states now, not at the next poll
        else:
            self.flash("couldn't open the session pane", "bad")

    def start_bg(self, cwd, title, extra):
        """Start in the session pane (see cmd_start), where a trust prompt can be answered."""
        if show_in_pane([SELF, "start", "--cwd", cwd, *extra], cwd, title):
            self.attached = None
            self.flash("starting… answer any prompt on the right")
        else:
            self.flash("couldn't open the session pane", "bad")
        self.store.poke()

    def new_session(self):
        opts = [(Path(p).name, p, str(Path(p).parent).replace(str(HOME), "~")) for p in recent_projects()]
        opts += [("~", str(HOME), "home folder"), ("Type a path…", "")]
        cwd = self.choose("Which folder?", opts, step="NEW SESSION · 1 of 3")
        if cwd is None:
            return
        if not cwd:
            cwd = self.ask("Folder path", complete=complete_dir, hint="tab completes · esc cancels")
            if not cwd:
                return
            cwd = os.path.abspath(os.path.expanduser(cwd))
            if not Path(cwd).is_dir():
                self.flash(f"no such folder: {cwd}", "bad")
                return
        where = cwd.replace(str(HOME), "~")
        name = self.ask(f"2 of 3 · Name it ({where})", hint="leave empty to skip · esc cancels")
        if name is None:
            return
        prompt = self.ask("3 of 3 · First message", hint="leave empty to skip · esc cancels")
        if prompt is None:
            return
        extra = (["--name", name] if name else []) + (["--prompt", prompt] if prompt else [])
        self.start_bg(cwd, name or Path(cwd).name or "~", extra)

    def launch_handoff(self, h):
        if not h["ready"] and not self.confirm("Its session is still writing it. Start anyway?", "start"):
            return
        src = h.get("source")
        # Claim it first: moving the file out of the queue is atomic, so a second ⏎ or a click
        # on a row the list hasn't refreshed yet finds nothing and can't launch it again.
        done = DONE / Path(h["path"]).name
        try:
            os.replace(h["path"], done)
        except FileNotFoundError:
            self.flash("that handoff was already started", "warn")
            self.store.poke()
            return
        h2 = {k: v for k, v in h.items() if k not in ("path", "source", "ready", "_place")}
        h2["launchedAt"] = time.time()
        write_json(done, h2)
        with self.store.lock:
            self.store.handoffs = [x for x in self.store.handoffs if x["id"] != h["id"]]
        self.start_bg(h["cwd"], h.get("title") or "handoff", ["--handoff", str(done)])
        if src and not src.get("bg"):
            self.flash(f"'{src.get('name')}' is in its own window: /exit there to close it")

    def resume_lost(self, r):
        """Pick up an interrupted session: reattach its background job, or resume the conversation."""
        name, cwd = r.get("name") or "", r.get("cwd") or str(HOME)
        if not Path(cwd).is_dir():
            self.flash(f"its folder is gone: {cwd}", "bad")
            return
        job = r.get("jobId")
        if r.get("kind") == "bg" and job and (CLAUDE_DIR / "jobs" / job).is_dir():
            if show_in_pane([claude_bin(), "attach", job], cwd, name or job, job):
                self.attached = job
            self.store.poke()
            return
        self.start_bg(cwd, name or lost_label(r)[:40], ["--resume", r["sessionId"]] + (["--name", name] if name else []))

    def close_lost(self, r, everything=False):
        """Done with a cut-off or standby session: stop offering it (its conversation stays in /resume)."""
        standby = r["cause"] == "standby"
        group = [x for x in self.store.lost if (x["cause"] == "standby") == standby] if everything else [r]
        what = (f"all {len(group)} {'standby' if standby else 'cut-off'} sessions" if everything
                else f"'{lost_label(r)[:24]}'")
        if not self.confirm(f"Close {what}?", "close"):
            return
        for x in group:
            job = x.get("jobId")
            if x.get("kind") == "bg" and job and (CLAUDE_DIR / "jobs" / job).is_dir():
                self.run_claude(["rm", job], HOME)  # or it would come back under PAUSED
            Path(x["path"]).unlink(missing_ok=True)
        self.flash("closed · conversation kept (claude --resume)")
        self.store.poke()

    def close(self, s):
        """Finish a session: it ends and leaves the list. Its conversation is kept, and its
        worktree is removed only when nothing in it is unpushed."""
        if not s["bg"]:
            self.flash("it's in its own window: type /exit there")
            return
        if not self.confirm(f"Close '{(s.get('name') or s['id'])[:26]}'?", "close"):
            return
        if self.remove(s):
            self.flash("closed · conversation kept (claude --resume)")

    def remove(self, s):
        code, out = self.run_claude(["rm", s["id"]], HOME)
        if code != 0:
            self.flash(f"not closed: {out.splitlines()[0][:100] if out else 'claude rm failed'}", "bad")
        else:
            ledger_end(s["id"], "closed")
            if self.attached == s["id"]:
                self.attached = None
        self.store.poke()
        return code == 0

    def handoff_of(self, s):
        """The started handoff (in done/) that this session came from, if any."""
        for f in DONE.glob("*.json"):
            h = read_json(f)
            if h and h.get("launchedSessionId") == s["id"]:
                return f
        return None

    def requeue(self, s):
        """Undo starting a handoff: close its session and put the handoff back in the queue."""
        f = self.handoff_of(s)
        if not f:
            self.flash("no handoff to put back", "warn")
            return
        if not self.confirm("Close it and put the handoff back?", "put back"):
            return
        if not self.remove(s):  # still running: requeuing now could start it twice
            return
        h = read_json(f)
        for k in ("launchedAt", "launchedSessionId"):
            h.pop(k, None)
        write_json(HANDOFFS / f.name, h)
        f.unlink(missing_ok=True)
        self.flash("closed · handoff back in the queue")
        self.store.poke()

    def pause(self, s):
        """Stop a session but keep it listed under PAUSED, to pick up again later."""
        if not s["bg"]:
            self.flash("it's in its own window: type /exit there")
            return
        if s.get("stopped"):
            self.flash("already paused · x closes it")
            return
        code, out = self.run_claude(["stop", s["id"]], HOME)
        self.flash("paused · open it to continue" if code == 0 else f"not paused: {out[:100]}",
                   "info" if code == 0 else "bad")
        if self.attached == s["id"]:
            self.attached = None
        self.store.poke()

    def discard_handoff(self, h):
        if self.confirm(f"Discard '{h.get('title', '')[:26]}'?", "discard"):
            src = Path(h["path"])
            DISCARDED.mkdir(parents=True, exist_ok=True)
            try:
                os.replace(src, DISCARDED / src.name)
                os.utime(DISCARDED / src.name)  # the 14 days count from now
                self.last_discard = DISCARDED / src.name
                self.flash("discarded · u brings it back")
            except FileNotFoundError:
                pass
            self.store.poke()

    def undo_discard(self):
        f, self.last_discard = self.last_discard, None
        if not f or not f.exists():
            self.flash("nothing to bring back", "warn")
            return
        os.replace(f, HANDOFFS / f.name)
        self.flash("handoff back in the queue")
        self.store.poke()

    # -- handoff folders
    def save_tree(self):
        write_json(TREE, sorted(list(k) for k in self.tree_open))

    def toggle_node(self, kind, obj, want=None):
        """Open or close a project or folder row in the handoff tree."""
        key = (kind, obj["id"])
        is_open = key in self.tree_open if want is None else not want
        (self.tree_open.discard if is_open else self.tree_open.add)(key)
        self.own_change = True
        self.save_tree()

    def move_handoff(self, h):
        """Choose which of its project's folders a handoff is in: ⏎ ticks or unticks one, and
        each change is saved as it's made. A handoff can be in several folders at once."""
        cwd, hid = h.get("cwd", ""), h.get("id")
        title = (h.get("title") or "handoff")[:30]
        at = 0
        while True:
            data = read_json(h["path"])
            if not data:
                self.flash("that handoff was started or discarded", "warn")
                self.store.poke()
                return
            now = handoff_folders(data)
            with self.store.lock:
                used = {n for x in self.store.handoffs if x.get("cwd") == cwd for n in handoff_folders(x)}
            names = project_folders(cwd)
            names += sorted((n for n in used | set(now) if n not in names), key=str.lower)
            opts = [(f"[{'x' if n in now else ' '}] {n}", n) for n in names]
            opts += [("+ New folder…", NEW_FOLDER), ("Done", None)]
            choice = self.choose("Folders it's in (⏎ ticks)", opts, step=f"{Path(cwd).name.upper()} · {title}",
                                 start=at, hint="each tick saves · esc or Done closes")
            if choice is None:
                break
            if choice == NEW_FOLDER:
                choice = self.ask("New folder name", hint="⏎ creates it and puts the handoff in it · esc cancels")
                if not choice:
                    continue
                choice = folder_name(cwd, choice)
                add_project_folder(cwd, choice)
                now = [n for n in now if n != choice]  # so the toggle below adds it
            at = next((i for i, (_l, v) in enumerate(opts) if v == choice), len(names))
            on = choice not in now
            set_handoff_folders(data, now + [choice] if on else [n for n in now if n != choice])
            write_json(h["path"], data)
            with self.store.lock:  # the list shows the change now, not at the next poll
                for x in self.store.handoffs:
                    if x.get("id") == hid:
                        set_handoff_folders(x, handoff_folders(data))
            if on:
                self.tree_open.update({("project", cwd), ("folder", f"{cwd}\n{choice}")})
            self.flash(f"{'in' if on else 'out of'} {choice}")
        final = handoff_folders(read_json(h["path"]) or {})
        self.tree_open.add(("project", cwd))
        self.save_tree()
        place = f"{cwd}\n{final[0]}" if final else cwd
        self.pending_key = ("handoff", f"{hid}\n{place}")
        self.own_change = True
        self.flash(f"in {', '.join(final)}" if final else f"in no folder: listed under {Path(cwd).name}")
        self.store.poke()

    def rename_folder(self, node):
        cwd, old = node["cwd"], node["name"]
        new = self.ask(f"Rename folder '{old[:24]}'", default=old, hint="⏎ renames · esc cancels")
        if not new or new == old:
            return
        new = folder_name(cwd, new)
        rename_project_folder(cwd, old, new)
        if ("folder", node["id"]) in self.tree_open:
            self.tree_open.add(("folder", f"{cwd}\n{new}"))
        self.pending_key = ("folder", f"{cwd}\n{new}")
        self.flash(f"renamed to {new}")
        self.store.poke()

    # -- source control
    def repo_folders(self):
        """Folders to look for git repos in: every session's and every handoff's (poll thread)."""
        with self.store.lock:
            return [x.get("cwd") for x in self.store.sessions + self.store.handoffs if x.get("cwd")]

    def git_action(self, repo, action):
        if action == "sync" and repo.get("upstream"):
            b, a = repo.get("behind", 0), repo.get("ahead", 0)
            if not self.confirm(f"Sync {repo['upstream'][:20]}: pull {b}, push {a}?", "sync"):
                return
        elif action == "sync" and not repo.get("upstream") and repo.get("remote") and repo.get("branch"):
            if not self.confirm(f"Publish {repo['branch'][:18]} to {repo['remote']}?", "publish"):
                return
        if self.repos.run(repo["path"], action):
            word = {"fetch": "fetching", "pull": "pulling", "push": "pushing", "sync": "syncing"}[action]
            self.flash(f"{repo['name']}: {word}…")
        else:
            self.flash(f"{repo['name']} is still busy", "warn")

    def actions_for(self, kind, obj):
        """The right-click menu: (label, action) for the clicked row."""
        if kind == "session" and not obj["bg"]:
            acts = [("Go to its window", lambda: self.attach(obj))]
        elif kind == "session":
            acts = [("Continue" if obj.get("stopped") else "Open", lambda: self.attach(obj))]
            if not obj.get("stopped"):
                acts.append(("Pause", lambda: self.pause(obj)))
            acts.append(("Close", lambda: self.close(obj)))
            if self.handoff_of(obj):
                acts.append(("Put back in queue", lambda: self.requeue(obj)))
        elif kind == "lost":
            standby = obj["cause"] == "standby"
            acts = [("Continue" if standby else "Resume", lambda: self.resume_lost(obj)),
                    ("Close", lambda: self.close_lost(obj)),
                    (f"Close all {'standby' if standby else 'cut-off'} sessions",
                     lambda: self.close_lost(obj, everything=True))]
        elif kind == "handoff":
            acts = [("Start", lambda: self.launch_handoff(obj)),
                    ("Read prompt", lambda: self.view_handoff(obj)),
                    ("Folders…", lambda: self.move_handoff(obj)),
                    ("Discard", lambda: self.discard_handoff(obj))]
        elif kind in ("project", "folder"):
            is_open = (kind, obj["id"]) in self.tree_open
            acts = [("Close" if is_open else "Open", lambda: self.toggle_node(kind, obj))]
            if kind == "folder":
                acts.append(("Rename folder…", lambda: self.rename_folder(obj)))
        elif kind == "repo":
            sync = "Sync (pull, then push)" if obj.get("upstream") else "Publish branch"
            acts = [(sync, lambda: self.git_action(obj, "sync")),
                    ("Pull", lambda: self.git_action(obj, "pull")),
                    ("Push", lambda: self.git_action(obj, "push")),
                    ("Fetch", lambda: self.git_action(obj, "fetch"))]
        else:
            acts = []
        return acts + ([(None, None)] if acts else []) + [("New session…", self.new_session)]

    def menu(self, y, options):
        """Popup under row y. Click or ⏎ picks; Esc, right-click or a click outside cancels."""
        h, w = self.scr.getmaxyx()
        width = min(w - 2, max(len(label) for label, _ in options if label) + 6)
        height = len(options) + 2
        top, left = max(0, min(y + 1, h - height)), 2
        win = curses.newwin(height, width, top, left)
        idx = 0

        def step(i, d):  # move to the next real item, past separators
            i = (i + d) % len(options)
            return i if options[i][0] else (i + d) % len(options)

        self.set_timeout(-1)
        try:
            while True:
                win.erase()
                win.attron(curses.color_pair(C_ACCENT))
                win.box()
                win.attroff(curses.color_pair(C_ACCENT))
                for i, (label, _) in enumerate(options):
                    if not label:  # separator: row actions above, general ones below
                        win.addnstr(1 + i, 1, "─" * (width - 2), width - 2, curses.color_pair(C_ACCENT) | curses.A_DIM)
                        continue
                    color = C_BAD if label == "Discard" else C_TEXT
                    attr = curses.color_pair(color + SEL) | curses.A_BOLD if i == idx else curses.color_pair(color)
                    win.addnstr(1 + i, 1, f" {label}".ljust(width - 2), width - 2, attr)
                win.refresh()
                ch = self.read()
                if isinstance(ch, Paste):
                    continue
                if ch in (curses.KEY_UP, ord("k")):
                    idx = step(idx, -1)
                elif ch in (curses.KEY_DOWN, ord("j")):
                    idx = step(idx, 1)
                elif ch in (10, 13, curses.KEY_ENTER):
                    break
                elif ch == 27:
                    return
                elif ch == curses.KEY_MOUSE:
                    try:
                        _, mx, my, _, bstate = curses.getmouse()
                    except curses.error:
                        continue
                    if not bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                        if bstate & (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED):
                            return
                        continue
                    if top < my < top + height - 1 and left <= mx < left + width:
                        if not options[my - top - 1][0]:
                            continue  # the separator line
                        idx = my - top - 1
                        break
                    return
        finally:
            del win
            self.set_timeout(400)
            self.scr.touchwin()
        options[idx][1]()

    def view_handoff(self, h):
        view = CACHE / "handoff-view.txt"
        view.write_text(f"{h.get('title')}\nfrom {h.get('sourceName') or '?'} · {h['cwd']}\n\n{h['prompt']}\n")
        show_in_pane(["less", str(view)], h["cwd"], f"handoff: {h.get('title')}")
        self.attached = None

    # -- drawing
    def bar(self, y, label, win, width, prefix="resets "):
        if not win:
            self.put(y, 1, label, curses.A_BOLD)
            self.put(y, 5, "no data yet", curses.A_DIM)
            return
        pct = win["pct"]
        color = C_OK if pct < 50 else C_WARN if pct < 80 else C_BAD
        fill = round(width * min(pct, 100) / 100)
        self.put(y, 1, label, curses.A_BOLD)
        self.put(y, 5, "█" * fill, curses.color_pair(color))
        self.put(y, 5 + fill, "░" * (width - fill), curses.A_DIM)
        self.put(y, 6 + width, f"{pct:>3.0f}%", curses.color_pair(color) | curses.A_BOLD)
        reset = fmt_reset(win.get("resetsAt"))
        if reset:
            self.put(y, 12 + width, f"{prefix}{reset}", curses.A_DIM)

    def usage_header(self, usage, w):
        """Two usage bars. They share one width, sized to leave room for the reset times;
        a narrow sidebar drops the word "resets" before it shrinks the bars to nothing."""
        wins = (usage.get("five_hour"), usage.get("seven_day"))
        resets = max((len(fmt_reset(x.get("resetsAt"))) for x in wins if x), default=0)
        prefix = "resets " if w - 13 - 7 - resets >= 6 else ""
        width = max(3, min(14, w - 13 - len(prefix) - resets))
        self.bar(1, "5h", wins[0], width, prefix)
        self.bar(2, "wk", wins[1], width, prefix)
        if usage.get("updatedAt") and time.time() - usage["updatedAt"] > 900:
            self.put(3, 1, f"usage as of {ago(usage['updatedAt'])}", curses.A_DIM)

    def item_key(self, item):
        kind, obj = item
        if kind == "handoff" and "_place" in obj:  # one handoff can be listed in several folders
            return kind, f"{obj.get('id')}\n{obj['_place']}"
        return kind, obj.get("id") or obj.get("sessionId") or obj.get("path")

    def row_look(self, kind, obj):
        """(icon, icon color, name, state word, state color, emphasis) for one row."""
        if kind == "session":
            state = session_state(obj)
            icon, color = {"working": ("●", C_OK), "needs you": ("!", C_WARN),
                           "your turn": ("○", C_ACCENT), "paused": ("‖", C_DIM),
                           "failed": ("✕", C_BAD)}.get(state, ("○", C_DIM))
            name = obj.get("name") or obj.get("id") or "?"
            emph = "dim" if obj.get("stopped") else "bold" if state == "needs you" else ""
            return icon, color, name, state, color, emph
        if kind == "lost" and obj["cause"] == "standby":
            if obj.get("jobState") == "blocked":
                return "!", C_WARN, lost_label(obj), "needs you", C_WARN, "bold"
            return "○", C_ACCENT, lost_label(obj), "your turn", C_ACCENT, ""
        if kind == "lost":
            return "↯", C_WARN, lost_label(obj), {"crashed": "crash"}.get(obj["cause"], obj["cause"]), C_WARN, ""
        if kind in ("project", "folder"):
            chevron = "▾" if (kind, obj["id"]) in self.tree_open else "▸"
            return chevron, C_ACCENT if kind == "project" else C_DIM, obj["name"], str(obj["count"]), C_DIM, \
                "bold" if kind == "project" else ""
        if kind == "repo":
            return (*self.repo_look(obj), "")
        if obj["ready"]:  # handoffs: ready is the normal case, so only "not ready" gets a word
            # in a folder, say which other folders it's in too (Launch work that's also Printers)
            here = str(obj.get("_place", "")).split("\n", 1)[1:] or [""]
            others = [n for n in handoff_folders(obj) if n != here[0]]
            also = others[0].split(" & ")[0] if others else ""  # "Platform & Fleet" -> "Platform"
            also = also if len(also) <= 11 else also[:10] + "…"
            if len(others) > 1:
                also += f" +{len(others) - 1}"
            return "→", C_ACCENT, obj.get("title", "?"), also, C_DIM, ""
        return "…", C_WARN, obj.get("title", "?"), "not ready", C_WARN, "dim"

    def repo_look(self, r):
        """(icon, icon color, name, state, state color) for a Source Control row, read like
        VS Code's status bar: branch, * for uncommitted changes, ↓ to pull, ↑ to push."""
        branch = r.get("branch") or "detached"
        branch = branch if len(branch) <= 12 else branch[:11] + "…"
        if r.get("busy"):
            word = {"fetch": "fetching…", "pull": "pulling…", "push": "pushing…", "sync": "syncing…"}[r["busy"]]
            return "⟳", C_ACCENT, r["name"], word, C_ACCENT
        if r.get("error"):
            return "✕", C_BAD, r["name"], "failed", C_BAD
        star = "*" if r.get("changes") else ""
        if not r.get("upstream"):
            return "⎇", C_DIM, r["name"], f"{branch}{star} · {'publish' if r.get('remote') else 'local'}", C_DIM
        b, a = r.get("behind", 0), r.get("ahead", 0)
        if not (a or b):
            return "⎇", C_DIM, r["name"], f"{branch}{star} ✓", C_DIM
        counts = " ".join(filter(None, [f"↓{b}" if b else "", f"↑{a}" if a else ""]))
        return "⎇", C_WARN if b else C_ACCENT, r["name"], f"{branch}{star} {counts}", C_WARN if b else C_ACCENT

    def draw_item(self, y, w, idx):
        kind, obj = self.items[idx]
        sel = idx == self.sel
        band = SEL if sel else 0
        icon, icolor, name, state, scolor, emph = self.row_look(kind, obj)
        attached = kind == "session" and obj.get("id") and obj.get("id") == self.attached
        indent = 2 * (self.depths[idx] if idx < len(self.depths) else 0)
        self.put(y, 0, " " * (w - 1), curses.color_pair(C_TEXT + band))
        if sel:
            self.put(y, 0, "▌", curses.color_pair(C_ACCENT + band))
        if attached:  # the session showing on the right
            self.put(y, 1, "▶", curses.color_pair(C_ACCENT + band))
        self.put(y, 2 + indent, icon, curses.color_pair(icolor + band) | curses.A_BOLD)
        weight = curses.A_BOLD if sel or attached or emph == "bold" else 0
        dim = curses.A_DIM if emph == "dim" and not sel else 0
        room = w - 5 - indent - (len(state) + 2 if state else 0)
        shown = name if len(name) <= room else name[:max(3, room - 1)].rstrip() + "…"
        self.put(y, 4 + indent, shown, curses.color_pair(C_TEXT + band) | weight | dim)
        if state:
            self.put(y, w - len(state) - 2, state, curses.color_pair(scolor + band) | dim)

    def detail_lines(self, w):
        """The selected row in full: (text, style) lines, style "name", "warn" or "" (dim)."""
        if not self.items:
            return []
        kind, obj = self.items[self.sel]
        width = w - 3
        out = []

        def add(text, style="", max_lines=2):
            out.extend((ln, style) for ln in wrap(text, width, max_lines))

        _icon, _c, name, _s, _sc, _e = self.row_look(kind, obj)
        add(name, "name")
        if kind == "session":
            add(obj.get("cwd", "").replace(str(HOME), "~"))
            bits = list(filter(None, [f"branch {obj['branch']}" if obj.get("branch") else "",
                                      f"started {ago(obj['startedAt'] / 1000)}" if obj.get("startedAt") else ""]))
            if len(" · ".join(bits)) <= width:
                add(" · ".join(bits), max_lines=1)
            else:  # too long for one line: each gets its own
                for bit in bits:
                    add(bit, max_lines=1)
            if obj.get("needs") and session_state(obj) == "needs you":
                add(f"needs you: {short_needs(obj['needs'], 300)}", "warn", 4)
            if not obj["bg"]:
                add("in its own window · /exit there to close")
        elif kind == "lost":
            where = obj.get("lastCwd") or obj.get("cwd", "")
            add(where.replace(str(HOME), "~"))
            if git_branch(where):
                add(f"branch {git_branch(where)}", max_lines=1)
            when = obj.get("lastActive") or obj.get("seenAt")
            if obj["cause"] == "standby":
                add(f"on standby since {ago(when)} · opens where it left off" if when
                    else "on standby · opens where it left off")
                if obj.get("needs") and obj.get("jobState") == "blocked":
                    add(f"needs you: {short_needs(obj['needs'], 300)}", "warn", 4)
            else:
                cause = "a reboot" if obj["cause"] == "reboot" else "a crash"
                add(f"cut off by {cause}" + (f" {ago(when)}" if when else ""), "warn")
            if obj.get("lastPrompt"):
                add(f"last ask: {obj['lastPrompt']}")
        elif kind in ("project", "folder"):
            n = obj["count"]
            where = obj["cwd"].replace(str(HOME), "~")
            add(where if kind == "project" else f"{Path(obj['cwd']).name} › {obj['name']}")
            what = f"{n} handoff{'s' * (n != 1)}"
            if kind == "project" and obj["folders"]:
                what += f" in {obj['folders']} folder{'s' * (obj['folders'] != 1)}"
            if obj.get("waiting"):
                what += f" · {obj['waiting']} not ready"
            add(what)
            is_open = (kind, obj["id"]) in self.tree_open
            add(("⏎ closes it" if is_open else "⏎ opens it") + " · m on a handoff picks its folders")
        elif kind == "repo":
            add(obj["path"].replace(str(HOME), "~"))
            branch = obj.get("branch") or "no branch (detached HEAD)"
            if obj.get("upstream"):
                add(f"{branch} → {obj['upstream']}", max_lines=1)
                b, a = obj.get("behind", 0), obj.get("ahead", 0)
                add(" · ".join(filter(None, [f"↓ {b} to pull" if b else "", f"↑ {a} to push" if a else ""]))
                    or "in sync", "warn" if b else "", 1)
            elif obj.get("remote"):
                add(f"{branch} · not on {obj['remote']} yet: ⏎ publishes it")
            else:
                add(f"{branch} · no remote: nothing to push to")
            c = obj.get("changes", 0)
            if c:
                add(f"* {c} uncommitted change{'s' * (c != 1)} (not pushed until committed)")
            if obj.get("checkedAt"):
                add(f"checked {obj.get('remote') or 'remote'} {ago(obj['checkedAt'])}", max_lines=1)
            if obj.get("error"):
                add(obj["error"], "warn", 4)
        else:
            src = obj.get("source")
            state = "has ended" if not src else ("is still writing it" if src.get("status") == "busy" else "is done")
            add(f"from {obj.get('sourceName') or '?'}, which {state}")
            if handoff_folders(obj):
                add(f"in {' · '.join(handoff_folders(obj))}")
            add(f"{obj.get('cwd', '').replace(str(HOME), '~')} · queued {ago(obj.get('createdAt', time.time()))}")
            prompt = " ".join(obj.get("prompt", "").split())
            if prompt:
                add(prompt, max_lines=5)
        return out

    def attention(self, mine, standby):
        """Header summary: how many sessions are waiting on you."""
        states = [session_state(s) for s in mine]
        states += ["needs you" if r.get("jobState") == "blocked" else "your turn" for r in standby]
        needs, turn = states.count("needs you"), states.count("your turn")
        return [(f"{needs} need{'s' * (needs == 1)} you", C_WARN) if needs else None,
                (f"{turn} your turn", C_ACCENT) if turn else None]

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        with self.store.lock:
            sessions = list(self.store.sessions)
            handoffs = list(self.store.handoffs)
            lost = [r for r in self.store.lost if r["cause"] != "standby"]
            standby = [r for r in self.store.lost if r["cause"] == "standby"]
            usage = dict(self.store.usage)
            err = self.store.error
        mine = [s for s in sessions if s["bg"] and not s.get("stopped")]
        paused = [s for s in sessions if s["bg"] and s.get("stopped")]
        windows = [s for s in sessions if not s["bg"]]
        handoffs.sort(key=lambda x: -(x.get("createdAt") or 0))  # newest first
        if self.focused and self.shown:
            # You're in the sidebar: rows keep the places you see them in, so a click can't
            # land on a row that just moved. States still update in place; anything new goes
            # to the end of its section; the fresh order applies once you leave the sidebar.
            first = {}  # a handoff's place is where it was first listed (it can be in several)
            for (k, kid), i in self.shown.items():
                if k == "handoff":
                    hid = kid.split("\n", 1)[0]
                    first[hid] = min(i, first.get(hid, i))

            def hold(kind, group):
                if kind == "handoff":
                    return sorted(group, key=lambda o: first.get(o.get("id"), len(self.shown)))
                return sorted(group, key=lambda o: self.shown.get(self.item_key((kind, o)), len(self.shown)))
            lost, mine, standby = hold("lost", lost), hold("session", mine), hold("lost", standby)
            paused, windows, handoffs = hold("session", paused), hold("session", windows), hold("handoff", handoffs)
        # handoffs as a tree: project › folder › handoff, opened and closed like a file tree
        rank = None
        if self.focused and self.shown:  # projects hold their places too; a new one goes last
            def rank(p, hs):
                return self.shown.get(("project", p), len(self.shown)), -max((h.get("createdAt") or 0) for h in hs)
        tree = handoff_tree(handoffs, all_folders(), lambda k: k in self.tree_open, rank)
        hand_rows = [(k, o) for k, o, _ in tree]
        repo_rows = [("repo", r) for r in self.repos.snapshot()]
        # self.sel indexes the list as it was last drawn: carry the selection to the same
        # item in the fresh list, so a session coming or going doesn't move it
        old = self.items
        key = self.item_key(old[self.sel]) if 0 <= self.sel < len(old) else None
        key, self.pending_key = self.pending_key or key, None
        # standby sessions are parked by Claude while they wait on you: they're listed with
        # the running ones, below them
        self.items = ([("lost", r) for r in lost] + [("session", s) for s in mine] + [("lost", r) for r in standby]
                      + [("session", s) for s in paused + windows] + hand_rows + repo_rows)
        self.depths = [0] * (len(self.items) - len(hand_rows) - len(repo_rows)) + [d for _, _, d in tree] + [0] * len(repo_rows)
        keys = [self.item_key(it) for it in self.items]
        self.shown = {k: i for i, k in enumerate(keys)}
        if keys != self.last_keys:  # remember the order before a change, for click()
            # a change you made yourself (opening a folder) isn't one to guard clicks against
            self.prev_keys, self.last_keys = self.last_keys, keys
            self.moved_at = 0.0 if self.own_change else time.time()
        self.own_change = False
        self.sel = keys.index(key) if key in keys else max(0, min(self.sel, len(self.items) - 1))
        self.rows = {}

        self.put(0, 1, "PLANE", curses.color_pair(C_ACCENT) | curses.A_BOLD)
        parts = [p for p in self.attention(mine, standby) if p]
        while parts and sum(len(t) for t, _ in parts) + 3 * (len(parts) - 1) > w - 10:
            parts.pop()  # a narrow sidebar keeps "needs you", the more urgent one
        x = w - 2 - sum(len(t) for t, _ in parts) - 3 * (len(parts) - 1)
        for i, (text, color) in enumerate(parts):
            if i:
                self.put(0, x, " · ", curses.A_DIM)
                x += 3
            self.put(0, x, text, curses.color_pair(color) | curses.A_BOLD)
            x += len(text)
        self.usage_header(usage, w)

        # body: section headings and item rows, scrolled to keep the selection visible
        body, idx = [], 0
        for title, group, count, empty in (("CUT OFF BY CRASH/REBOOT", lost, len(lost), None),
                                           ("SESSIONS", mine + standby, len(mine) + len(standby),
                                            "none running · n starts one"),
                                           ("PAUSED", paused, len(paused), None),
                                           ("IN OTHER WINDOWS", windows, len(windows), None),
                                           ("HANDOFFS", hand_rows, len(handoffs), "none queued"),
                                           ("SOURCE CONTROL", repo_rows, len(repo_rows), None)):
            if not group and empty is None:
                continue
            if body:
                body.append(("gap", None))
            body.append(("head", (title, count)))
            if not group:
                body.append(("note", empty))
            for _ in group:
                body.append(("item", idx))
                idx += 1

        # the details of the selected row keep a fixed place at the bottom, above the
        # message and key lines; the list scrolls in the space above them
        details = self.detail_lines(w)
        top = 4
        room = h - 2 - top
        detail_h = min(len(details), max(0, room - 6), max(4, min(9, room // 3)))
        list_bottom = h - 2 - (detail_h + 1 if detail_h else 0)
        avail = max(1, list_bottom - top)
        if len(body) <= avail:
            offset = 0
        else:
            sel_row = next((i for i, (k, v) in enumerate(body) if k == "item" and v == self.sel), 0)
            off = min(max(getattr(self, "offset", 0), sel_row - avail + 1), sel_row, len(body) - avail)
            if off == sel_row and off > 0 and body[off - 1][0] == "head":
                off -= 1  # keep the section heading in view
            self.offset = offset = max(0, off)
        y = top
        for kind, val in body[offset:offset + avail]:
            if kind == "head":
                title, count = val
                self.put(y, 1, title, curses.A_BOLD | (curses.color_pair(C_WARN) if title.startswith("CUT OFF") else 0))
                if count:
                    self.put(y, 2 + len(title), str(count), curses.A_DIM)
            elif kind == "note":
                self.put(y, 4, val, curses.A_DIM)
            elif kind == "item":
                self.draw_item(y, w, val)
                self.rows[y] = val
            y += 1
        hidden_above = sum(1 for k, _ in body[:offset] if k == "item")
        hidden_below = sum(1 for k, _ in body[offset + avail:] if k == "item")
        if hidden_above:
            more = f"▲ {hidden_above} more"
            self.put(top - 1, w - len(more) - 2, more, curses.A_DIM)

        if detail_h:
            rule = "─" * (w - 1)
            if hidden_below:  # the hidden count sits on the rule, where the list stops
                more = f" ▼ {hidden_below} more "
                rule = rule[:2] + more + rule[2 + len(more):]
            self.put(list_bottom, 0, rule, curses.A_DIM)
            for i, (text, style) in enumerate(details[:detail_h]):
                attr = (curses.A_BOLD if style == "name" else
                        curses.color_pair(C_WARN) if style == "warn" else curses.A_DIM)
                self.put(list_bottom + 1 + i, 1, text, attr)
        elif hidden_below:
            self.put(list_bottom - 1, w - 12, f"▼ {hidden_below} more", curses.A_DIM)

        if self.msg and time.time() - self.msg_at < 6:
            self.put(h - 2, 1, self.msg[:w - 2], curses.color_pair(TONES.get(self.msg_tone, C_ACCENT)))
        elif err:
            self.put(h - 2, 1, err[:w - 2], curses.color_pair(C_BAD))
        kind, obj = self.items[self.sel] if self.items else (None, None)
        if kind == "handoff":
            hint = "v read  m folders  x discard  n new  ? keys"
        elif kind in ("project", "folder"):
            hint = "⏎ open/close  ← up  n new  ? keys"
        elif kind == "repo":
            hint = ("⏎ sync  p pull  P push  f fetch  ? keys" if obj.get("upstream")
                    else "⏎ publish  f fetch  ? keys" if obj.get("remote") else "n new session  ? keys")
        elif kind == "lost" or (kind == "session" and obj["bg"] and obj.get("stopped")):
            hint = "x close  n new  ? keys"
        elif kind == "session" and obj["bg"]:
            hint = "x close  p pause  n new  ? keys"
        else:
            hint = "n new session  ? keys"
        x = 1
        pairs = hint.split("  ")
        while len(pairs) > 1 and len("  ".join(pairs)) > w - 2:
            pairs.pop(-2)  # a narrow sidebar drops hints from the middle; "? keys" stays
        for pair in pairs:  # the key stands out, its word stays quiet
            key, _, word = pair.partition(" ")
            self.put(h - 1, x, key, curses.A_BOLD)
            self.put(h - 1, x + len(key) + 1, word, curses.A_DIM)
            x += len(pair) + 2
        scr.refresh()

    def help(self):
        self.scr.erase()
        rows = [  # the sidebar is ~38 columns: keys in 9, words in 26; "#" rows are headings
            ("#", "ANY ROW"),
            ("⏎ click", "open it"),
            ("r-click", "all its actions"),
            ("↑↓ jk", "move the selection"),
            ("#", "SESSIONS"),
            ("x", "close: off the list,"),
            ("", "conversation kept"),
            ("p", "pause: stays listed"),
            ("#", "HANDOFFS"),
            ("⏎ click", "open/close a project"),
            ("", "or folder"),
            ("←", "close it, or go up"),
            ("⏎ 2×click", "start a handoff"),
            ("v", "read the prompt"),
            ("m", "its folders (several ok)"),
            ("x", "discard (u undoes)"),
            ("#", "SOURCE CONTROL"),
            ("⏎", "sync: pull, then push"),
            ("p / P", "pull / push"),
            ("f", "fetch (auto every 3m)"),
            ("#", "PLANE"),
            ("n", "new session"),
            ("super ←→", "sidebar ⇄ session"),
            ("r / R", "refresh / reload code"),
            ("q", "quit (sessions go on)"),
            ("#", "TIP"),
            (None, "In a session, ← on an empty"),
            (None, "prompt opens Claude's own"),
            (None, "list; ⏎ there comes back."),
        ]
        self.put(0, 1, "KEYS", curses.color_pair(C_ACCENT) | curses.A_BOLD)
        y = 1
        for k, d in rows:
            if k == "#":
                y += 1
                self.put(y, 1, d, curses.A_BOLD | curses.color_pair(C_ACCENT))
            else:
                self.put(y, 2, k or "", curses.A_BOLD)
                self.put(y, 2 if k is None else 13, d, curses.A_DIM)
            y += 1
        self.put(y + 1, 1, "any key to go back", curses.A_DIM)
        self.set_timeout(-1)
        self.read()
        self.set_timeout(400)

    def current(self):
        return self.items[self.sel] if self.items else (None, None)

    def activate(self):
        kind, obj = self.current()
        if kind == "session":
            self.attach(obj)
        elif kind == "handoff":
            self.launch_handoff(obj)
        elif kind == "lost":
            self.resume_lost(obj)
        elif kind in ("project", "folder"):
            self.toggle_node(kind, obj)
        elif kind == "repo":
            self.git_action(obj, "sync")

    def tree_left(self):
        """← in the handoff tree: close an open project or folder, or step up to the row it's in."""
        kind, obj = self.current()
        if kind in ("project", "folder") and (kind, obj["id"]) in self.tree_open:
            self.toggle_node(kind, obj, want=False)
            return
        depth = self.depths[self.sel] if self.sel < len(self.depths) else 0
        if kind in ("handoff", "folder") and depth:
            parent = next((i for i in range(self.sel - 1, -1, -1) if self.depths[i] < depth), None)
            if parent is not None:
                self.sel = parent

    def click(self, row):
        # A handoff starts a whole session, so it needs a double-click (or ⏎) to start.
        # Both clicks must land on the same handoff entry: keyed by its id, not the row,
        # because the list can refresh and shift between the two clicks.
        now = time.time()
        kind, obj = self.items[row]
        if (now - self.moved_at < 0.7 and row < len(self.prev_keys)
                and self.prev_keys[row] != self.item_key(self.items[row])):
            # the list changed just before this click, and this row now holds something
            # else: you were aiming at what used to be here, so don't open the wrong one
            self.flash("the list just changed: click again", "warn")
            return
        key = (kind, obj.get("id") if isinstance(obj, dict) else row)
        prev_key, prev_at = self.last_click
        if key == prev_key and now - prev_at < 0.08:
            return  # the same physical click reported twice (pressed + clicked)
        self.last_click = (key, now)
        self.sel = row
        if kind == "repo":
            pass  # a click only selects: pull and push reach GitHub, so they take ⏎ or the menu
        elif kind != "handoff":
            self.activate()
        elif key == prev_key and now - prev_at < 0.5:
            self.last_click = (None, 0)
            self.activate()
        else:
            self.flash("double-click or press Enter to start")

    def loop(self):
        last_sync = 0
        while True:
            if time.time() - last_sync > 3:
                self.attached = attached_id()
                last_sync = time.time()
            if self.open_request:
                sid, self.open_request = self.open_request, None
                with self.store.lock:
                    s = next((s for s in self.store.sessions if s.get("id") == sid and not s.get("stopped")), None)
                if s:
                    self.attach(s)
                    keys = [self.item_key(it) for it in self.items]
                    if ("session", sid) in keys:  # select it too, so its details show
                        self.sel = keys.index(("session", sid))
            self.draw()
            if self.resized_at and time.time() - self.resized_at > 0.3:
                self.resized_at = 0
                self.split_total = settle_resize(self.split_total)
            try:
                ch = self.read()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return
            if isinstance(ch, Paste):
                dbg(f"paste {ch[:40]!r}")
                self.forward_paste(ch)
                continue
            mev = None
            if ch == curses.KEY_MOUSE:
                try:
                    mev = curses.getmouse()
                except curses.error:
                    pass
                dbg(f"mouse {mev} rows={sorted(self.rows)}")
            else:
                dbg(f"key {curses.keyname(ch) if isinstance(ch, int) and 0 <= ch < 512 else ch!r}")
            if ch == curses.KEY_RESIZE:
                self.resized_at = time.time()
                continue
            kind, obj = self.current()
            if ch in (curses.KEY_UP, ord("k")):
                self.sel = max(0, self.sel - 1)
            elif ch in (curses.KEY_DOWN, ord("j")):
                self.sel = min(len(self.items) - 1, self.sel + 1)
            elif ch in (curses.KEY_HOME, ord("g")):
                self.sel = 0
            elif ch in (curses.KEY_END, ord("G")):
                self.sel = len(self.items) - 1
            elif ch in (curses.KEY_RIGHT, ord("l")) and kind in ("project", "folder"):
                if (kind, obj["id"]) not in self.tree_open:
                    self.toggle_node(kind, obj, want=True)
                elif self.sel + 1 < len(self.items):
                    self.sel += 1  # already open: step into it
            elif ch in (curses.KEY_RIGHT, ord("l")) and kind == "repo":
                pass  # → never syncs; ⏎ does, after asking
            elif ch in (10, 13, curses.KEY_ENTER, curses.KEY_RIGHT, ord("l")):
                self.activate()
            elif ch in (curses.KEY_LEFT, ord("h")):
                self.tree_left()
            elif ch == ord("m") and kind == "handoff":
                self.move_handoff(obj)
            elif ch == ord("p") and kind == "repo":
                self.git_action(obj, "pull")
            elif ch == ord("P") and kind == "repo":
                self.git_action(obj, "push")
            elif ch == ord("f") and kind == "repo":
                self.git_action(obj, "fetch")
            elif ch == ord("n"):
                self.new_session()
            elif ch in (ord("x"), ord("X"), ord("d")):
                if kind == "session":
                    self.close(obj)
                elif kind == "lost":
                    self.close_lost(obj)
                elif kind == "handoff":
                    self.discard_handoff(obj)
            elif ch == ord("p") and kind == "session":
                self.pause(obj)
            elif ch == ord("u"):
                self.undo_discard()
            elif ch == ord("v") and kind == "handoff":
                self.view_handoff(obj)
            elif ch == ord("r"):
                self.store.poke()
            elif ch == ord("R"):  # reload the sidebar's code in place; the session pane stays
                curses.endwin()
                os.execv(sys.executable, [sys.executable, SELF, "sidebar"])
            elif ch == ord("?"):
                self.help()
            elif ch == ord("q"):
                kitty("close-window", "--match", "var:plane_role=session")
                return
            elif ch == curses.KEY_MOUSE:
                if mev is None:
                    continue
                _, _, my, _, bstate = mev
                if bstate & curses.BUTTON4_PRESSED:
                    self.sel = max(0, self.sel - 1)
                elif bstate & getattr(curses, "BUTTON5_PRESSED", 0):
                    self.sel = min(len(self.items) - 1, self.sel + 1)
                elif bstate & (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED):
                    if my in self.rows:
                        self.sel = self.rows[my]
                        self.draw()
                        self.menu(my, self.actions_for(*self.items[self.sel]))
                    else:
                        self.menu(my, self.actions_for(None, None))
                elif my in self.rows and bstate & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                    self.click(self.rows[my])


def cmd_sidebar(_args):
    os.environ.setdefault("ESCDELAY", "25")
    for d in (HANDOFFS, DONE, CACHE, LIVE):
        d.mkdir(parents=True, exist_ok=True)
    try:
        curses.wrapper(lambda scr: Sidebar(scr).loop())
    finally:
        sys.stdout.write("\x1b[?2004l\x1b[?1004l")
        sys.stdout.flush()


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="plane", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("open").set_defaults(fn=cmd_open)
    sub.add_parser("sidebar").set_defaults(fn=cmd_sidebar)
    sub.add_parser("statusline").set_defaults(fn=cmd_statusline)
    st = sub.add_parser("start", help="start a background session (runs in the session pane)")
    st.add_argument("--cwd")
    st.add_argument("--name")
    st.add_argument("--prompt")
    st.add_argument("--handoff", help="a claimed handoff file in done/")
    st.add_argument("--resume", help="conversation id to continue as a background session")
    st.set_defaults(fn=cmd_start)
    fo = sub.add_parser("focus", help="move focus between Plane's panes")
    fo.add_argument("dir", choices=["left", "right", "up", "down"])
    fo.set_defaults(fn=cmd_focus)
    tr = sub.add_parser("track", help="Claude Code hook: record running sessions")
    tr.add_argument("event", choices=["start", "prompt", "end"])
    tr.set_defaults(fn=cmd_track)
    wb = sub.add_parser("web", help="serve the phone app on 127.0.0.1 (put it on Tailscale with tailscale serve)")
    wb.add_argument("--port", type=int, default=8377)
    wb.set_defaults(fn=cmd_web)
    rc = sub.add_parser("recover", help="notify about interrupted sessions and waiting handoffs")
    rc.add_argument("--delay", type=float, default=8)
    rc.set_defaults(fn=cmd_recover)
    ho = sub.add_parser("handoff").add_subparsers(dest="hcmd", required=True)
    add = ho.add_parser("add", help="queue a handoff prompt read from stdin")
    add.add_argument("--title", required=True)
    add.add_argument("--cwd")
    add.add_argument("--folder", action="append",
                     help="file it in this folder of its project (created if new); repeat for several")
    add.set_defaults(fn=cmd_handoff_add)
    fl = ho.add_parser("folders", help="list a project's handoff folders")
    fl.add_argument("--cwd")
    fl.set_defaults(fn=cmd_handoff_folders)
    args = ap.parse_args()
    (getattr(args, "fn", None) or cmd_open)(args)


if __name__ == "__main__":
    main()
