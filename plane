#!/usr/bin/env python3
"""plane: one kitty window for all your Claude Code sessions.

  plane open                      focus the Plane window, or launch it
  plane sidebar                   the sidebar TUI (runs inside the Plane window)
  plane start --cwd DIR           start a background session in the session pane
  plane focus left|right|up|down  move focus between Plane's panes (Super+arrows)
  plane handoff add --title T     queue a handoff prompt read from stdin
  plane statusline                Claude Code statusLine command; records usage
  plane track start|prompt|end    Claude Code hook: keep the ledger of running sessions
  plane recover                   at login: notify about interrupted sessions + handoffs
"""
import argparse
import curses
import json
import os
import pty
import re
import shutil
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
CLAUDE_DIR = HOME / ".claude"
DATA = HOME / ".local/share/plane"
HANDOFFS = DATA / "handoffs"
DONE = HANDOFFS / "done"
CACHE = HOME / ".cache/plane"
USAGE = CACHE / "usage.json"
LIVE = DATA / "live"  # one file per session that was running; one left behind = interrupted
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
SOCK = RUNTIME / "plane-kitty.sock"
CLASS = "plane"
SIDEBAR_COLS = 38
SELF = str(Path(__file__).resolve())


def claude_bin():
    return shutil.which("claude") or str(HOME / ".local/bin/claude")


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def write_json(path, data):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(tmp, path)


def ppid_of(pid):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def hypr(*args):
    """Hyprland is optional: without it, window focusing outside Plane is skipped."""
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5)
    except OSError:
        return subprocess.CompletedProcess(args, 127, "", "hyprctl not found")


def hypr_clients():
    try:
        return json.loads(hypr("clients", "-j").stdout)
    except (ValueError, OSError, subprocess.SubprocessError):
        return []


def hypr_dispatch(lua, *classic):
    """Hyprland 0.56+ takes Lua dispatches; older versions take the classic form."""
    r = hypr("dispatch", lua)
    out = (r.stdout + r.stderr).lower()
    if r.returncode != 0 or "invalid" in out or "error" in out:
        hypr("dispatch", *classic)


def hypr_focus(selector):
    hypr_dispatch(f'hl.dsp.focus({{ window = "{selector}" }})', "focuswindow", selector)


def hypr_move_focus(direction):
    hypr_dispatch(f'hl.dsp.focus({{ direction = "{direction}" }})', "movefocus", direction[0])


# ---------------------------------------------------------------- open

def cmd_open(_args):
    if any(c.get("class") == CLASS for c in hypr_clients()):
        hypr_focus(f"class:^({CLASS})$")
        return
    if SOCK.exists() and kitty("focus-window", "--match", "cmdline:sidebar").returncode == 0:
        return  # already open (no Hyprland to ask): kitty raises it
    SOCK.unlink(missing_ok=True)
    subprocess.Popen(
        ["kitty", "--class", CLASS, "--title", "Plane",
         "-o", "allow_remote_control=socket-only",
         "--listen-on", f"unix:{SOCK}",
         "-o", "enabled_layouts=splits",
         "--directory", str(HOME),
         SELF, "sidebar"],
        start_new_session=True, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------- focus

def cmd_focus(args):
    """Super+arrows: inside Plane, move between its panes; past its edge or in any other
    window, plain Hyprland focus. Safe to bind globally."""
    if shutil.which("hyprctl"):
        try:
            active = json.loads(hypr("activewindow", "-j").stdout or "{}").get("class")
        except ValueError:
            active = None
        if active != CLASS:
            hypr_move_focus(args.dir)
            return
    side = {"up": "top", "down": "bottom"}.get(args.dir, args.dir)
    r = kitty("focus-window", "--match", f"neighbor:{side}")
    dbg(f"focus {args.dir} rc={r.returncode} {r.stderr.strip()[:120]}")
    if r.returncode != 0:
        hypr_move_focus(args.dir)


# ---------------------------------------------------------------- statusline

def _window(rl, *names):
    """Pull (percent, resets_at) for one window out of whatever shape rate_limits has."""
    if isinstance(rl, dict):
        for n in names:
            w = rl.get(n)
            if isinstance(w, dict):
                pct = next((w[k] for k in ("used_percentage", "percentUsed", "percent_used",
                                           "utilization", "used") if k in w), None)
                reset = next((w[k] for k in ("resets_at", "resetsAt") if k in w), None)
                if pct is not None:
                    return {"pct": float(pct), "resetsAt": reset}
    if isinstance(rl, list):
        for w in rl:
            if isinstance(w, dict) and w.get("kind") in names:
                return {"pct": float(w.get("percentUsed", 0)), "resetsAt": w.get("resetsAt")}
    return None


def cmd_statusline(_args):
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    rl = payload.get("rate_limits") or payload.get("rateLimits")
    five = _window(rl, "five_hour", "fiveHour", "5h")
    week = _window(rl, "seven_day", "sevenDay", "weekly", "7d")
    if five or week:
        write_json(USAGE, {"five_hour": five, "seven_day": week, "updatedAt": time.time()})
    parts = []
    if five:
        parts.append(f"5h {five['pct']:.0f}%")
    if week:
        parts.append(f"wk {week['pct']:.0f}%")
    print(" · ".join(parts))


# ---------------------------------------------------------------- handoff add

def find_source_session():
    pid = os.getppid()
    for _ in range(40):
        if pid <= 1:
            break
        info = read_json(CLAUDE_DIR / "sessions" / f"{pid}.json")
        if info:
            return info
        pid = ppid_of(pid)
    return None


def repo_root(cwd):
    # A handoff starts at the main checkout; the prompt itself moves into the worktree.
    return cwd.split("/.worktrees/")[0].split("/.claude/worktrees/")[0]


def cmd_handoff_add(args):
    prompt = sys.stdin.read().strip()
    fence = re.match(r"^```[\w-]*\n(.*)\n```$", prompt, re.S)
    if fence:
        prompt = fence.group(1).strip()
    if not prompt:
        sys.exit("plane: empty handoff prompt (pass it on stdin)")
    src = find_source_session() or {}
    cwd = repo_root(os.path.abspath(args.cwd or src.get("cwd") or os.getcwd()))
    now = time.time()
    slug = re.sub(r"[^a-z0-9]+", "-", args.title.lower()).strip("-")[:40] or "handoff"
    hid = f"{datetime.now():%Y%m%d-%H%M%S}-{slug}"
    write_json(HANDOFFS / f"{hid}.json", {
        "id": hid, "title": args.title, "cwd": cwd, "prompt": prompt, "createdAt": now,
        "sourceSessionId": src.get("sessionId"), "sourceName": src.get("name"),
        "sourcePid": src.get("pid"), "sourceProcStart": src.get("procStart"),
    })
    origin = f" (from session '{src['name']}')" if src.get("name") else ""
    print(f"Queued handoff '{args.title}' in Plane{origin}.")


# ---------------------------------------------------------------- session ledger
# Every session writes LIVE/<sessionId>.json from its hooks and marks it ended when it
# exits. A crash, power loss or reboot never gets that far, so a record whose process is
# gone and that isn't marked ended is a session that was cut off mid-work.

def boot_id():
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except OSError:
        return ""


def proc_start(pid):
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def proc_alive(pid, start=None):
    return bool(pid) and proc_start(pid) is not None and (not start or proc_start(pid) == str(start))


def cmdline(pid):
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace").split("\0")
    except OSError:
        return []


def is_headless(pid):
    return any(a in ("-p", "--print") for a in cmdline(pid))


def hook_claude_pid():
    """The Claude process that ran this hook: the nearest ancestor that is `claude`."""
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            return 0
        argv = cmdline(pid)
        if (CLAUDE_DIR / "sessions" / f"{pid}.json").exists() or (argv and Path(argv[0]).name == "claude"):
            return pid
        pid = ppid_of(pid)
    return 0


def shutting_down():
    """True while the machine or the desktop session is going down (exits then aren't choices)."""
    checks = (["systemctl", "is-system-running"],
              ["systemctl", "--user", "is-active", "wayland-session-shutdown.target"],
              ["systemctl", "--user", "is-active", "graphical-session.target"])
    for cmd, bad in zip(checks, ({"stopping"}, {"active", "activating"}, {"deactivating", "inactive"})):
        try:
            if subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout.strip() in bad:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    return False


def ledger_update(sid, pid, **fields):
    f = LIVE / f"{sid}.json"
    rec = read_json(f, {}) or {}
    info = read_json(CLAUDE_DIR / "sessions" / f"{pid}.json", {}) or {}
    if rec.get("pid") != pid:  # a new process for this conversation (resumed): it's live again
        rec.pop("ended", None)
    rec.update({k: v for k, v in fields.items() if v})
    rec.update(sessionId=sid, pid=pid, procStart=proc_start(pid), bootId=boot_id(), seenAt=time.time())
    for key in ("kind", "jobId", "name"):
        if info.get(key):
            rec[key] = info[key]
    rec.setdefault("cwd", info.get("cwd") or fields.get("lastCwd") or str(HOME))  # launch dir: where --resume finds it
    rec.setdefault("startedAt", time.time())
    write_json(f, rec)


def cmd_track(args):
    """Hook entry point. Prints nothing (hook stdout lands in the conversation) and never fails."""
    try:
        payload = json.load(sys.stdin)
        sid = payload.get("session_id")
        pid = hook_claude_pid()
        if not sid or not pid or is_headless(pid):
            return
        f = LIVE / f"{sid}.json"
        if args.event == "end":
            rec = read_json(f)
            if rec and not shutting_down():
                rec.update(ended=time.time(), endReason=payload.get("reason"))
                write_json(f, rec)
            return
        fields = {"lastCwd": payload.get("cwd"), "transcript": payload.get("transcript_path")}
        if args.event == "prompt":
            prompt = " ".join(str(payload.get("prompt", "")).split())[:300]
            fields.update(lastPrompt=prompt, lastActive=time.time())
            if not (read_json(f, {}) or {}).get("firstPrompt"):
                fields["firstPrompt"] = prompt
        ledger_update(sid, pid, **fields)
    except Exception:
        pass


def ledger_sync():
    """Record sessions that started before the hooks existed; drop old ended records."""
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        info = read_json(f, {}) or {}
        pid, sid = info.get("pid"), info.get("sessionId")
        if not sid or not proc_alive(pid, info.get("procStart")) or is_headless(pid):
            continue
        rec = read_json(LIVE / f"{sid}.json")
        if rec is None or (rec.get("pid") == pid and not rec.get("ended") and rec.get("name") != info.get("name")):
            ledger_update(sid, pid, lastCwd=info.get("cwd"))
    for f in LIVE.glob("*.json"):
        rec = read_json(f, {}) or {}
        if rec.get("ended") and time.time() - rec["ended"] > 86400:
            f.unlink(missing_ok=True)


def interrupted_sessions():
    """Sessions whose process is gone without having ended: newest activity first."""
    live = set()
    for f in (CLAUDE_DIR / "sessions").glob("*.json"):
        info = read_json(f, {}) or {}
        if proc_alive(info.get("pid"), info.get("procStart")):
            live.add(info.get("sessionId"))
    out, boot = [], boot_id()
    for f in LIVE.glob("*.json"):
        rec = read_json(f)
        if not rec or rec.get("ended") or rec.get("sessionId") in live:
            continue
        if rec.get("bootId") == boot and proc_alive(rec.get("pid"), rec.get("procStart")):
            continue
        rec["path"] = str(f)
        rec["cause"] = "reboot" if rec.get("bootId") != boot else "crashed"
        out.append(rec)
    out.sort(key=lambda r: -(r.get("lastActive") or r.get("seenAt") or 0))
    return out


def lost_label(r):
    return r.get("name") or r.get("firstPrompt") or Path(r.get("cwd", "")).name or r["sessionId"][:8]


def cmd_recover(args):
    """Login reminder: a notification that stays until clicked, listing what was left open."""
    time.sleep(args.delay)  # let the notification daemon come up first
    lost = interrupted_sessions()
    waiting = [h for h in (read_json(f) for f in sorted(HANDOFFS.glob("*.json"))) if h]
    if not lost and not waiting:
        return
    title = " · ".join(filter(None, (
        f"{len(lost)} session{'s' * (len(lost) != 1)} cut off" if lost else "",
        f"{len(waiting)} handoff{'s' * (len(waiting) != 1)} waiting" if waiting else "")))
    lines = [f"↯ {lost_label(r)[:50]}" for r in lost[:6]] + [f"→ {h.get('title', '?')[:50]}" for h in waiting[:6]]
    r = subprocess.run(["notify-send", "-a", "Plane", "-i", "plane", "-u", "critical", "-A", "open=Open Plane",
                        title, "\n".join(lines)], capture_output=True, text=True)
    if r.stdout.strip() == "open":
        cmd_open(None)


# ---------------------------------------------------------------- data

def git_branch(cwd):
    m = re.search(r"/\.(?:claude/)?worktrees/([^/]+)", cwd)
    if m:
        return m.group(1)
    git = Path(cwd) / ".git"
    try:
        if git.is_file():
            git = Path(git.read_text().split("gitdir:", 1)[1].strip())
        head = (git / "HEAD").read_text().strip()
        return head.rsplit("/", 1)[-1] if head.startswith("ref:") else head[:8]
    except (OSError, IndexError):
        return ""


def recent_projects(limit=10):
    seen = []
    try:
        lines = (CLAUDE_DIR / "history.jsonl").read_text(errors="replace").splitlines()
    except OSError:
        return seen
    for line in reversed(lines):
        try:
            p = json.loads(line).get("project")
        except ValueError:
            continue
        if not p or p in seen or p == str(HOME) or "/.worktrees/" in p:
            continue
        if Path(p).is_dir():
            seen.append(p)
        if len(seen) >= limit:
            break
    return seen


def complete_dir(text):
    """Extend a typed path to the longest folder prefix it uniquely starts."""
    base = os.path.expanduser(text or "~/")
    parent, stem = os.path.split(base)
    try:
        names = sorted(e.name for e in os.scandir(parent or ".") if e.is_dir()
                       and e.name.startswith(stem) and (stem.startswith(".") or not e.name.startswith(".")))
    except OSError:
        return text
    if not names:
        return text
    common = os.path.commonprefix(names)
    done = os.path.join(parent, common) + ("/" if len(names) == 1 else "")
    return done.replace(str(HOME), "~", 1) if text.startswith("~") or not text else done


class Store:
    """Polls sessions, handoffs and usage on a background thread."""

    def __init__(self, on_ready):
        self.lock = threading.Lock()
        self.sessions, self.handoffs, self.usage, self.lost = [], [], {}, []
        self.error = ""
        self.on_ready = on_ready
        self._ready_seen = None
        self._wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def poke(self):
        self._wake.set()

    def _loop(self):
        while True:
            try:
                self._refresh()
            except Exception as exc:  # keep polling whatever happens
                self.error = f"refresh: {exc}"
            self._wake.wait(2.5)
            self._wake.clear()

    def _refresh(self):
        out = subprocess.run([claude_bin(), "agents", "--json", "--all"],
                             capture_output=True, text=True, timeout=15)
        raw = json.loads(out.stdout or "[]")
        sessions, stopped = [], []
        for s in raw:
            bg = s.get("kind") == "background"
            s["bg"] = bg
            s["branch"] = git_branch(s.get("cwd", ""))
            files = read_json(CLAUDE_DIR / "sessions" / f"{s.get('pid')}.json", {}) if s.get("pid") else {}
            s["procStart"] = files.get("procStart")
            if bg:
                job = read_json(CLAUDE_DIR / "jobs" / s["id"] / "state.json", {})
                s["needs"] = job.get("needs") or job.get("detail") or ""
            alive = bool(s.get("pid")) and Path(f"/proc/{s['pid']}").exists()
            (sessions if alive else stopped).append(s)
        sessions.sort(key=lambda s: (not s["bg"], s.get("startedAt", 0)))
        ledger_sync()
        lost = interrupted_sessions()
        lost_ids = {r["sessionId"] for r in lost}
        stopped = [s for s in stopped if s.get("sessionId") not in lost_ids]  # listed as interrupted
        stopped.sort(key=lambda s: -s.get("startedAt", 0))
        for s in stopped:
            s["stopped"] = True

        handoffs = []
        for f in sorted(HANDOFFS.glob("*.json")):
            h = read_json(f)
            if not h:
                continue
            h["path"] = str(f)
            src = next((s for s in sessions if s.get("pid") == h.get("sourcePid")
                        and (not h.get("sourceProcStart") or s.get("procStart") == h["sourceProcStart"])),
                       None) or next((s for s in sessions if s.get("sessionId") == h.get("sourceSessionId")), None)
            h["source"] = src
            h["ready"] = src is None or src.get("status") != "busy"
            handoffs.append(h)

        ready_now = {h["id"] for h in handoffs if h["ready"]}
        if self._ready_seen is not None:
            for h in handoffs:
                if h["id"] in ready_now - self._ready_seen:
                    self.on_ready(h)
        self._ready_seen = ready_now

        with self.lock:
            self.sessions = sessions + stopped
            self.handoffs = handoffs
            self.lost = lost
            self.usage = read_json(USAGE, {}) or {}
            self.error = "" if out.returncode == 0 else (out.stderr.strip()[:80] or "claude agents failed")


# ---------------------------------------------------------------- kitty

def dbg(text):
    """Event log for troubleshooting, only with PLANE_DEBUG=1: ~/.cache/plane/debug.log."""
    if not os.environ.get("PLANE_DEBUG"):
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(CACHE / "debug.log", "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} [{os.getpid()}] {text}\n")


def kitty(*args):
    if args and args[0] in ("focus-window", "launch", "close-window", "send-text"):
        dbg(f"kitty {args[:4]}")
    to = os.environ.get("KITTY_LISTEN_ON") or f"unix:{SOCK}"
    return subprocess.run(["kitty", "@", "--to", to, *args], capture_output=True, text=True, timeout=10)


def kitty_windows():
    try:
        data = json.loads(kitty("ls").stdout)
    except ValueError:
        return []
    return [w for o in data for t in o["tabs"] for w in t["windows"]]


def attached_id():
    for w in kitty_windows():
        if w.get("user_vars", {}).get("plane_role") == "session":
            return w["user_vars"].get("plane_id")
    return None


def show_in_pane(cmd, cwd, title, pane_id=""):
    """Replace the right-hand pane with `cmd` (closing it only detaches)."""
    kitty("close-window", "--match", "var:plane_role=session")
    r = kitty("launch", "--type=window", "--location=vsplit",
              "--var", "plane_role=session", "--var", f"plane_id={pane_id}",
              "--cwd", cwd, "--title", title, *cmd)
    fit_sidebar()
    return r.returncode == 0


def fit_sidebar():
    """Pin the sidebar's width; kitty otherwise rescales both panes on every resize."""
    me = os.environ.get("KITTY_WINDOW_ID")
    for _ in range(3):  # resizes land in steps; nudge until it sits at the target
        wins = kitty_windows()
        if len(wins) < 2:
            return
        total = sum(w["columns"] for w in wins)
        target = SIDEBAR_COLS if total >= 110 else max(24, round(total * 0.34))
        cols = next((w["columns"] for w in wins if str(w["id"]) == me), None)
        if cols is None or abs(cols - target) <= 1:
            return
        kitty("resize-window", "--match", f"id:{me}", "--axis", "horizontal",
              "--increment", str(target - cols))


# ---------------------------------------------------------------- start

def cmd_start(args):
    """Runs in the session pane: `claude --bg` on a real terminal, so a folder-trust
    prompt (always shown for ~) can be answered right there, then attaches in place."""
    h = read_json(args.handoff) if args.handoff else None
    cwd = os.path.expanduser((h or {}).get("cwd") or args.cwd or str(HOME))
    name = (h or {}).get("title", "")[:60] if h else (args.name or "")
    prompt = (h or {}).get("prompt", "") if h else (args.prompt or "")
    cmd = ([claude_bin(), "--bg"] + (["--resume", args.resume] if args.resume else [])
           + (["--name", name] if name else []) + ([prompt] if prompt else []))
    out = bytearray()

    def tee(fd):
        data = os.read(fd, 4096)
        out.extend(data)
        return data

    os.chdir(cwd)
    pty.spawn(cmd, tee)
    text = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", out.decode(errors="replace"))
    m = re.search(r"backgrounded\s*·\s*([0-9a-f]{6,})", text)
    sid = m and m.group(1)
    if not sid and args.resume:  # find the job by the conversation it continued
        for info in (read_json(f, {}) or {} for f in (CLAUDE_DIR / "sessions").glob("*.json")):
            if info.get("sessionId") == args.resume and info.get("jobId") and proc_alive(info.get("pid")):
                sid = info["jobId"]
    if not sid:
        if h:  # back into the queue so it can be launched again
            h.pop("launchedAt", None)
            write_json(HANDOFFS / Path(args.handoff).name, h)
            Path(args.handoff).unlink(missing_ok=True)
        input("\nNo session started. Enter to close… ")
        return
    if h:
        h["launchedSessionId"] = sid
        write_json(args.handoff, h)
    if args.stop_source:
        subprocess.run([claude_bin(), "stop", args.stop_source], capture_output=True, timeout=60)
    kitty("set-user-vars", "--match", f"id:{os.environ.get('KITTY_WINDOW_ID')}", f"plane_id={sid}")
    os.execvp(cmd[0], [cmd[0], "attach", sid])


